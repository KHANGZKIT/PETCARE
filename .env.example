# ============================================================
# PET CARE Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your local values.
# Spring Boot does NOT read .env files by default.
# Set these as system/user environment variables, or pass them
# via IDE run configuration, or use a shell script.
# ============================================================

# ============================================================
# Docker Compose (PostgreSQL & pgAdmin)
# ============================================================
POSTGRES_DB=pet_care
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

PGADMIN_DEFAULT_EMAIL=admin@petcare.com
PGADMIN_DEFAULT_PASSWORD=admin_password_here

# ============================================================
# Backend local connection (Spring Boot)
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/pet_care
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Server port (default: 8080)
SERVER_PORT=8080

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400000



