<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PetcareUI" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_ink</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_foreground</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/surface_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/surface_background</item>
    </style>
</resources>
