<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <LinearLayout
        android:id="@+id/layoutAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/surface_background"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_foreground" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStaffScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="Quản lý khung giờ"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvStaffClinicSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Phòng khám"
                android:textColor="@color/brand_primary"
                android:fontFamily="@font/open_sans_medium"
                android:textSize="12.5sp"
                tools:text="Phòng khám Thú y An Nhiên · Quận 1" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnTopAddSlot"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_service_icon"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_plus"
                app:tint="@color/brand_ink" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutStateToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutAppBar"
        android:background="@color/surface_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:letterSpacing="0.06"
            android:text="CHẾ ĐỘ:"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/open_sans_medium"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipStateDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Mặc định"
                    android:textColor="@color/white"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipStateNewSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Tạo khung giờ"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipStateCreated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Đã tạo"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipStateEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Không có khung giờ"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutDateStripContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutStateToggle"
        android:background="@color/surface_background"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutDateStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSlotsBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavStaff"
        android:layout_below="@id/layoutDateStripContainer"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/noticeCreated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notice_success"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/status_success_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Đã tạo khung giờ"
                        android:textColor="@color/status_success_ink"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvNoticeCreatedBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="14:00 – 14:30 đã mở để nhận đặt lịch."
                        android:textColor="@color/status_success_ink"
                        android:fontFamily="@font/open_sans_regular"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/noticeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notice_brand"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info"
                    app:tint="@color/brand_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNoticeDateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ngày hôm nay"
                        android:textColor="@color/brand_ink"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textSize="13sp"
                        tools:text="Thứ 2, 27/10/2026" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Mỗi khung giờ kéo dài 30 phút. Đóng khung giờ sẽ ẩn nó khỏi ứng dụng của khách."
                        android:textColor="@color/brand_ink"
                        android:fontFamily="@font/open_sans_regular"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="-0.02"
                    android:text="Khung giờ trong ngày"
                    android:textColor="@color/text_foreground"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvSlotCountHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 khung"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSlotsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/layoutEmptySlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="36dp"
                android:paddingBottom="36dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_empty_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar_plus"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="-0.02"
                    android:text="Chưa có khung giờ cho ngày này"
                    android:textColor="@color/text_foreground"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="16.5sp" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Phòng khám chưa mở hoặc các khung giờ đã bị xóa. Thêm khung giờ để bắt đầu nhận đặt lịch."
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_regular"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEmptyCreateSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_btn_primary"
                    android:letterSpacing="-0.01"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:stateListAnimator="@null"
                    android:text="Tạo khung giờ"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:fontFamily="@font/open_sans_semibold"
                    android:includeFontPadding="false"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCreateNewSlot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_outline"
                android:drawableStart="@drawable/ic_plus"
                android:drawableTint="@color/text_foreground"
                android:letterSpacing="-0.01"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:stateListAnimator="@null"
                android:text="Tạo khung giờ mới"
                android:textAllCaps="false"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:textSize="17.5sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutFloatingToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNavStaff"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_floating_toast_success"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvFloatingToastText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="-0.01"
            android:text="Đã tạo khung giờ · 14:00 – 14:30"
            android:textColor="@color/white"
            android:fontFamily="@font/open_sans_medium"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavStaff"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_card"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/navStaffToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Hôm nay"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffAppointments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_days"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Lịch hẹn"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffSlots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_bottom_nav_active_pill">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_clock"
                    app:tint="@color/brand_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Khung giờ"
                android:textColor="@color/brand_primary"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_user"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tài khoản"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutNewSlotSheetOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="30dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_sheet"
            android:orientation="vertical"
            android:padding="20dp">

            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_pill_gray" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar_circle">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_plus"
                    app:tint="@color/brand_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="-0.02"
                android:text="Tạo khung giờ mới"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="17.5sp" />

            <TextView
                android:id="@+id/tvSheetCreateSlotSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Thêm khung giờ trống. Khách có thể đặt ngay khi bạn lưu."
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_regular"
                android:textSize="12.5sp"
                tools:text="Thêm khung giờ trống cho Thứ 2, 27/10/2026. Khách có thể đặt ngay khi bạn lưu." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnStartTimePicker"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvNewSlotStartTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="14:00"
                        android:textColor="@color/text_foreground"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnEndTimePicker"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvNewSlotEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="14:30"
                        android:textColor="@color/text_foreground"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_inactive"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/chipRecurrenceOnce"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_service_card_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Một khung"
                    android:textColor="@color/brand_ink"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipRecurrenceDaily"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Lặp lại mỗi ngày"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSheetCreateSlotAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:letterSpacing="-0.01"
                android:stateListAnimator="@null"
                android:text="Tạo khung giờ"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/btnSheetCreateSlotDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="Đóng"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_semibold"
                android:textSize="13.5sp" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
