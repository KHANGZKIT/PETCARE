<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <!-- 1. Fixed Top Bar -->
    <LinearLayout
        android:id="@+id/layoutAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/ds_background"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/ds_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStaffScreenTitle"
                style="@style/TextAppearance.PetCare.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:text="Quản lý khung giờ"
                android:textColor="@color/ds_text_primary"
                android:textSize="18sp"
                app:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvStaffClinicSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_regular"
                android:maxLines="1"
                android:text="Phòng khám"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp"
                tools:text="Thú y PetCare Cầu Diễn" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnTopAddSlot"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_outline_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/open_sans_semibold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="+ Thêm giờ"
            android:textColor="@color/ds_primary"
            android:textSize="12.5sp"
            app:fontFamily="@font/open_sans_semibold" />
    </LinearLayout>

    <!-- Hidden prototype toggles -->
    <LinearLayout
        android:id="@+id/layoutStateToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutAppBar"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView android:id="@+id/chipStateDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/chipStateNewSlot" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/chipStateCreated" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/chipStateEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 2. Date Strip -->
    <LinearLayout
        android:id="@+id/layoutDateStripContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutStateToggle"
        android:background="@color/ds_background"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutDateStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 3. Scrollable Slots Body -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSlotsBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavStaff"
        android:layout_below="@id/layoutDateStripContainer"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/noticeCreated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_notice_success"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/ds_success" />

                <TextView
                    android:id="@+id/tvNoticeCreatedBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/open_sans_regular"
                    android:text="Khung giờ mới đã mở để nhận đặt lịch."
                    android:textColor="@color/ds_success"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/noticeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_clinic"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvNoticeDateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="Ngày hôm nay"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="13.5sp"
                    app:fontFamily="@font/open_sans_semibold"
                    tools:text="Thứ 3, 24/11/2026" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:text="Khung giờ bị đóng sẽ tạm ẩn khỏi màn chọn giờ của khách hàng."
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.PetCare.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="Khung giờ trong ngày"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="16.5sp"
                    app:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:id="@+id/tvSlotCountHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_semibold"
                    android:fontFeatureSettings="tnum"
                    android:text="0 khung"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12.5sp"
                    app:fontFamily="@font/open_sans_semibold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSlotsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/layoutEmptySlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="32dp"
                android:paddingBottom="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_corgi_booking" />

                <TextView
                    style="@style/TextAppearance.PetCare.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="Chưa có khung giờ cho ngày này"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="16.5sp"
                    app:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Thêm khung giờ khám mới để bắt đầu nhận đặt lịch từ khách hàng."
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEmptyCreateSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="@font/open_sans_semibold"
                    android:includeFontPadding="false"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:stateListAnimator="@null"
                    android:text="Tạo khung giờ"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    app:backgroundTint="@null"
                    app:fontFamily="@font/open_sans_semibold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCreateNewSlot"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_btn_outline_primary"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="+ Tạo khung giờ mới"
                android:textAllCaps="false"
                android:textColor="@color/ds_primary"
                android:textSize="14sp"
                app:backgroundTint="@null"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Hidden floating toast -->
    <LinearLayout
        android:id="@+id/layoutFloatingToast"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <TextView android:id="@+id/tvFloatingToastText" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 4. Crisp Warm Tactile Bottom Nav -->
    <LinearLayout
        android:id="@+id/bottomNavStaff"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav_bar"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navStaffToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home"
                app:tint="@color/ds_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:text="Hôm nay"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffAppointments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_days"
                app:tint="@color/ds_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:text="Lịch hẹn"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffSlots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_bottom_nav_active_pill">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_clock"
                    app:tint="@color/ds_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:text="Khung giờ"
                android:textColor="@color/ds_primary"
                android:textSize="11sp"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_user"
                app:tint="@color/ds_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:text="Tài khoản"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Create Slot Bottom Sheet Overlay -->
    <FrameLayout
        android:id="@+id/layoutNewSlotSheetOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#801F1A17"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_sheet"
            android:orientation="vertical"
            android:padding="20dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_pill_gray" />

            <TextView
                style="@style/TextAppearance.PetCare.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:text="Tạo khung giờ mới"
                android:textColor="@color/ds_text_primary"
                android:textSize="17sp"
                app:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvSheetCreateSlotSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_regular"
                android:text="Thêm khung giờ trống. Khách có thể đặt ngay khi bạn lưu."
                android:textColor="@color/ds_text_secondary"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnStartTimePicker"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/ds_text_secondary" />

                    <TextView
                        android:id="@+id/tvNewSlotStartTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:fontFeatureSettings="tnum"
                        android:text="14:00"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnEndTimePicker"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_field"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/ds_text_secondary" />

                    <TextView
                        android:id="@+id/tvNewSlotEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:fontFeatureSettings="tnum"
                        android:text="14:30"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipRecurrenceOnce"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/open_sans_semibold"
                    android:gravity="center"
                    android:text="Một khung"
                    android:textColor="@color/ds_primary"
                    android:textSize="12.5sp"
                    app:fontFamily="@font/open_sans_semibold" />

                <TextView
                    android:id="@+id/chipRecurrenceDaily"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/open_sans_medium"
                    android:gravity="center"
                    android:text="Lặp lại mỗi ngày"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSheetCreateSlotAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_primary"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:stateListAnimator="@null"
                android:text="Tạo khung giờ"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:backgroundTint="@null"
                app:fontFamily="@font/open_sans_semibold" />

            <TextView
                android:id="@+id/btnSheetCreateSlotDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/open_sans_semibold"
                android:padding="8dp"
                android:text="Đóng"
                android:textColor="@color/ds_text_secondary"
                android:textSize="13.5sp"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
