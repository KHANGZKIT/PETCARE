<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_card_borderless"
    android:clickable="true"
    android:elevation="0dp"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Legacy left stripe kept hidden for binding compatibility -->
    <View
        android:id="@+id/viewStatusAccent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Hàng đầu phiếu: ● Trạng thái phẳng (không pill pastel) -->
    <TextView
        android:id="@+id/tvApptStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_semibold"
        android:includeFontPadding="false"
        android:text="● Chờ xác nhận"
        android:textColor="@color/ds_warning"
        android:textSize="12.5sp"
        app:fontFamily="@font/open_sans_semibold" />

    <!-- Hàng giữa phiếu: Ảnh bé bo 10dp + Tên dịch vụ + Bé · Phòng khám -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivPetImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/ds_cream_tile"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_corgi_running"
            app:shapeAppearanceOverlay="@style/RoundedCorner10"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvServiceTitle"
                style="@style/TextAppearance.PetCare.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_bold"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:text="Tiêm phòng"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp"
                app:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvPetAndClinic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_regular"
                android:maxLines="1"
                android:text="Mochi · Thú y PetCare Cầu Diễn"
                android:textColor="@color/ds_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Đường kẻ nét đứt kiểu cuống phiếu (Ticket Dashed Divider) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_divider_dashed"
        android:layerType="software" />

    <!-- Cuống phiếu: 1 dòng ngày giờ tự nhiên + Chi tiết › -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_calendar_days"
            app:tint="@color/ds_text_secondary" />

        <TextView
            android:id="@+id/tvApptDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:fontFamily="@font/open_sans_semibold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ds_text_primary"
            android:textSize="12.5sp"
            app:fontFamily="@font/open_sans_semibold"
            tools:text="T2, 23/11 · 09:00" />

        <!-- Legacy time view kept hidden for binding compatibility -->
        <TextView
            android:id="@+id/tvApptTime"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_semibold"
            android:text="Chi tiết"
            android:textColor="@color/ds_primary"
            android:textSize="12.5sp"
            app:fontFamily="@font/open_sans_semibold" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/ds_primary" />
    </LinearLayout>
</LinearLayout>
