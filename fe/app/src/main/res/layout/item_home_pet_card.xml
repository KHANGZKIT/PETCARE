<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardHomePet"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_home_card_borderless"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivHomePetAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@color/ds_home_bg"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/img_pet_mochi"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeWidth="0dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHomePetName"
            style="@style/TextAppearance.PetCare.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="156dp"
            tools:text="Miu Miu" />

        <TextView
            android:id="@+id/tvHomePetSpecies"
            style="@style/TextAppearance.PetCare.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_mint"
            android:includeFontPadding="false"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/ds_mint_ink"
            tools:text="Mèo Anh lông ngắn" />
    </LinearLayout>

</LinearLayout>
