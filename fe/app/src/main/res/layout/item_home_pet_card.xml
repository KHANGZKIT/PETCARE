<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardHomePet"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_home_card_borderless"
    android:clickable="true"
    android:elevation="0dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivHomePetAvatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@color/ds_cream_tile"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/img_pet_mochi"
        app:shapeAppearanceOverlay="@style/RoundedCorner10"
        app:strokeWidth="0dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHomePetName"
            style="@style/TextAppearance.PetCare.CardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_bold"
            android:maxLines="1"
            android:maxWidth="148dp"
            android:textSize="14.5sp"
            tools:text="Mochi" />

        <TextView
            android:id="@+id/tvHomePetSpecies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/open_sans_medium"
            android:includeFontPadding="false"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp"
            tools:text="Chó Corgi" />
    </LinearLayout>

</LinearLayout>
