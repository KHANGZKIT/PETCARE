<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_home_card_borderless"
    android:clickable="true"
    android:elevation="0dp"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Legacy priority stripe kept hidden for binding compatibility -->
    <View
        android:id="@+id/viewPriorityBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Hàng đầu phiếu: ● Trạng thái phẳng -->
    <TextView
        android:id="@+id/tvStaffApptStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_semibold"
        android:includeFontPadding="false"
        android:text="● Chờ xác nhận"
        android:textColor="@color/ds_warning"
        android:textSize="12.5sp"
        app:fontFamily="@font/open_sans_semibold" />

    <!-- Hàng giữa phiếu: Ảnh bé bo 10dp + Tên dịch vụ + Chủ nuôi · Bé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStaffPetAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@color/ds_cream_tile"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_pet_mochi"
            app:shapeAppearanceOverlay="@style/RoundedCorner10"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStaffServiceTitle"
                style="@style/TextAppearance.PetCare.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_bold"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:text="Tiêm phòng"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp"
                app:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvStaffCustomerPet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_regular"
                android:maxLines="1"
                android:text="Nguyễn Lan · Mochi"
                android:textColor="@color/ds_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Đường kẻ nét đứt cuống phiếu -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_divider_dashed"
        android:layerType="software" />

    <!-- Cuống phiếu: Ngày giờ tự nhiên + Chi tiết › -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_calendar_days"
            app:tint="@color/ds_text_secondary" />

        <TextView
            android:id="@+id/tvStaffDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/open_sans_semibold"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/ds_text_primary"
            android:textSize="12.5sp"
            app:fontFamily="@font/open_sans_semibold"
            tools:text="T2, 24/11 · 10:00" />

        <TextView
            android:id="@+id/tvStaffTime"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStaffDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_regular"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp"
            tools:text="· 30 phút" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_semibold"
            android:text="Chi tiết"
            android:textColor="@color/ds_primary"
            android:textSize="12.5sp"
            app:fontFamily="@font/open_sans_semibold"
            tools:ignore="HardcodedText" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/ds_primary" />
    </LinearLayout>
</LinearLayout>
