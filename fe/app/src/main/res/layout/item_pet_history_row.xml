<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowPetHistory"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Bên trái: Icon vuông bo 10dp trên nền kem #F3EDE4 -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_shortcut_icon_cream">

        <ImageView
            android:id="@+id/ivHistoryServiceIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_stethoscope"
            app:tint="@color/ds_primary" />
    </FrameLayout>

    <!-- Ở giữa: Tên dịch vụ (SemiBold) + Ngày khám · Phòng khám -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHistoryServiceName"
            style="@style/TextAppearance.PetCare.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_semibold"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="2"
            android:textColor="@color/ds_text_primary"
            android:textSize="14sp"
            app:fontFamily="@font/open_sans_semibold"
            tools:text="Khám sức khỏe tổng quát" />

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_regular"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp"
            tools:text="15/11/2026 · 09:00 · Thú y PetCare" />
    </LinearLayout>

    <!-- Bên phải: Trạng thái phẳng (không pill pastel) -->
    <TextView
        android:id="@+id/tvHistoryStatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_semibold"
        android:includeFontPadding="false"
        android:text="● Hoàn thành"
        android:textColor="@color/ds_success"
        android:textSize="12sp"
        app:fontFamily="@font/open_sans_semibold" />

</LinearLayout>
