<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <LinearLayout
        android:id="@+id/layoutStaffAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/surface_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_paw"
                    app:tint="@color/warm_coral"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvStaffSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Khu vực nhân viên"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="13sp"
                    tools:text="Khu vực nhân viên · Cầu Giấy · Hà Nội" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStaffClinicName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:letterSpacing="-0.02"
                android:maxLines="2"
                android:text="Phòng khám"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="20sp"
                tools:text="Phòng khám Thú y An Nhiên" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnStaffNotifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_bell"
                app:tint="@color/text_foreground" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_step_dot_active"
                android:backgroundTint="@color/warm_coral" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnStaffAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true">

            <TextView
                android:id="@+id/tvStaffAvatarInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.04"
                android:text="NV"
                android:textColor="@color/brand_ink"
                android:fontFamily="@font/open_sans_semibold"
                android:textSize="14.5sp"
                tools:text="TT" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutStateToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutStaffAppBar"
        android:background="@color/surface_background"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="2dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chipStateDefault"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Mặc định"
            android:textColor="@color/ds_primary"
            android:fontFamily="@font/open_sans_medium"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipStateLoading"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Đang tải"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/open_sans_medium"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chipStateEmpty"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Không có lịch hẹn"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/open_sans_medium"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollStaffBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutStaffBottomNav"
        android:layout_below="@id/layoutStateToggle"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/layoutDefaultContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/cardStaffHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_hero_banner_gradient"
                    android:elevation="0dp"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="-14dp"
                        android:layout_marginBottom="-16dp"
                        android:alpha="0.12"
                        android:rotation="-18"
                        android:src="@drawable/ic_paw"
                        app:tint="@color/white"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_gray"
                            android:backgroundTint="#26FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@drawable/ic_stethoscope"
                                app:tint="@color/white"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:letterSpacing="0.04"
                                android:text="ĐIỀU PHỐI PHÒNG KHÁM"
                                android:textColor="@color/white"
                                android:fontFamily="@font/open_sans_medium"
                                android:textSize="10.5sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:letterSpacing="-0.02"
                            android:text="Tổng quan ca trực hôm nay"
                            android:textColor="@color/white"
                            android:fontFamily="@font/open_sans_bold"
                            android:textSize="19.5sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Kiểm tra nhanh các yêu cầu đặt lịch mới và quản lý khung giờ trực của phòng khám."
                            android:textColor="#E0F2FE"
                            android:fontFamily="@font/open_sans_regular"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </FrameLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:letterSpacing="-0.02"
                        android:text="Cần bạn xử lý"
                        android:textColor="@color/text_foreground"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="17.5sp" />

                    <TextView
                        android:id="@+id/tvSeeAllPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Xem tất cả ›"
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="13sp" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_notice_warning"
                    android:elevation="0dp"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="1.5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alert_triangle"
                        app:tint="@color/status_warning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPendingNoticeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 yêu cầu đang chờ duyệt"
                            android:textColor="@color/status_warning_ink"
                            android:fontFamily="@font/open_sans_semibold"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Khách hàng nhận thông báo ngay khi bạn xác nhận hoặc từ chối."
                            android:textColor="@color/status_warning_ink"
                            android:fontFamily="@font/open_sans_regular"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutPendingList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvTodayScheduleTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:letterSpacing="-0.02"
                        android:text="Hôm nay"
                        android:textColor="@color/text_foreground"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="17.5sp"
                        tools:text="Hôm nay · Thứ 2 27/10" />

                    <TextView
                        android:id="@+id/tvSeeAllToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Danh sách đầy đủ ›"
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="13sp" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/layoutTodaySchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/cardClinicShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card_clinic"
                    android:elevation="0dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.02"
                        android:text="Quản lý phòng khám"
                        android:textColor="@color/text_foreground"
                        android:fontFamily="@font/open_sans_bold"
                        android:textSize="17.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/shortcutNewSlot"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_service_icon">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_plus"
                                    app:tint="@color/brand_primary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Tạo khung giờ khám"
                                android:textColor="@color/text_foreground"
                                android:fontFamily="@font/open_sans_medium"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/brand_primary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="#F0EEE9" />

                        <LinearLayout
                            android:id="@+id/shortcutManageSlots"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_service_icon_amber">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_calendar_clock"
                                    app:tint="@color/status_warning_ink" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Quản lý lịch trong tuần"
                                android:textColor="@color/text_foreground"
                                android:fontFamily="@font/open_sans_medium"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/brand_primary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="#F0EEE9" />

                        <LinearLayout
                            android:id="@+id/shortcutClinicProfile"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_service_icon_coral">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_user"
                                    app:tint="@color/warm_coral" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Hồ sơ phòng khám &amp; nhân viên"
                                android:textColor="@color/text_foreground"
                                android:fontFamily="@font/open_sans_semibold"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/brand_primary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLoadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:indeterminateTint="@color/brand_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Đang tải lịch hẹn hôm nay…"
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="13sp" />
                </LinearLayout>

                <include layout="@layout/item_clinic_row_skeleton" />
                <include layout="@layout/item_clinic_row_skeleton" />
                <include layout="@layout/item_clinic_row_skeleton" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_empty_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Hôm nay chưa có lịch hẹn"
                    android:textColor="@color/text_foreground"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="280dp"
                    android:text="Yêu cầu đặt lịch mới sẽ xuất hiện ngay khi khách gửi."
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_regular"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/btnEmptyManageSlots"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:elevation="0dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mở quản lý khung giờ"
                        android:textColor="@color/white"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutStaffBottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_card"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navStaffToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_bottom_nav_active_pill">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home"
                    app:tint="@color/brand_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hôm nay"
                android:textColor="@color/brand_primary"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffAppointments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_days"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lịch hẹn"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffSlots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_clock"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Khung giờ"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_user"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tài khoản"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
