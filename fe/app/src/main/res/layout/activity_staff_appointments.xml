<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <LinearLayout
        android:id="@+id/layoutStaffAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/surface_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_foreground" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStaffScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="Lịch hẹn phòng khám"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvStaffClinicSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Phòng khám"
                android:textColor="@color/brand_primary"
                android:fontFamily="@font/open_sans_medium"
                android:textSize="12.5sp"
                tools:text="Phòng khám Thú y An Nhiên · Quận 1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutStateToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutStaffAppBar"
        android:background="@color/surface_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:letterSpacing="0.06"
            android:text="CHẾ ĐỘ:"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/open_sans_medium"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipStateDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Mặc định"
                    android:textColor="@color/white"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipStateLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Đang tải"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipStateEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Không khớp"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/chipStateError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Lỗi"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSearchAndFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutStateToggle"
        android:background="@color/surface_background"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/brand_primary" />

            <EditText
                android:id="@+id/etStaffSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Tìm theo tên bé, chủ nuôi hoặc dịch vụ..."
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textColor="@color/text_foreground"
                android:textColorHint="@color/text_muted"
                android:fontFamily="@font/open_sans_regular"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnFilterSliders"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:src="@drawable/ic_sliders"
                app:tint="@color/brand_ink" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Tất cả · 0"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipFilterPending"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Chờ xác nhận · 0"
                    android:textColor="@color/white"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipFilterConfirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Đã xác nhận · 0"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipFilterCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Đã hoàn thành · 0"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipFilterNoShow"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Không đến · 0"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollStaffAppointmentsBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavStaff"
        android:layout_below="@id/layoutSearchAndFilter"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/layoutDefaultContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/tvSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="-0.01"
                    android:text="Danh sách lịch hẹn"
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:id="@+id/layoutApptList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnLoadOlder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_btn_outline"
                    android:elevation="1dp"
                    android:letterSpacing="-0.01"
                    android:stateListAnimator="@null"
                    android:text="Tải lịch hẹn cũ hơn"
                    android:textAllCaps="false"
                    android:textColor="@color/text_foreground"
                    android:fontFamily="@font/open_sans_semibold"
                    android:includeFontPadding="false"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutLoadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/brand_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Đang tải lịch hẹn…"
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <include layout="@layout/item_clinic_row_skeleton" />
                <include layout="@layout/item_clinic_row_skeleton" />
                <include layout="@layout/item_clinic_row_skeleton" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="54dp"
                android:paddingEnd="32dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_empty_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="-0.02"
                    android:text="Không có lịch hẹn phù hợp"
                    android:textColor="@color/text_foreground"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="16.5sp" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Thử đổi bộ lọc trạng thái hoặc xóa tìm kiếm để xem cả ngày."
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_regular"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEmptyShowAll"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_btn_primary"
                    android:letterSpacing="-0.01"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:stateListAnimator="@null"
                    android:text="Xem tất cả trạng thái"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:fontFamily="@font/open_sans_semibold"
                    android:includeFontPadding="false"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="54dp"
                android:paddingEnd="32dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_error_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alert_triangle"
                        app:tint="@color/status_destructive_ink" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="-0.02"
                    android:text="Không tải được danh sách lịch hẹn"
                    android:textColor="@color/text_foreground"
                    android:fontFamily="@font/open_sans_bold"
                    android:textSize="16.5sp" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Lịch của phòng khám chưa tải được. Kiểm tra kết nối rồi thử lại."
                    android:textColor="@color/text_muted"
                    android:fontFamily="@font/open_sans_regular"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_btn_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/text_foreground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="-0.01"
                        android:text="Thử lại"
                        android:textColor="@color/text_foreground"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomNavStaff"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_card"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navStaffToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hôm nay"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffAppointments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_bottom_nav_active_pill">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_days"
                    app:tint="@color/brand_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lịch hẹn"
                android:textColor="@color/brand_primary"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffSlots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_clock"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Khung giờ"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStaffProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_user"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tài khoản"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
