<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- 1. Thanh AppBar nhân viên cố định trên cùng -->
    <LinearLayout
        android:id="@+id/layoutStaffAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/surface_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <!-- Nút Back tròn -->
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_foreground" />
        </FrameLayout>

        <!-- Tiêu đề AppBar & Tên phòng khám -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStaffScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="Lịch hẹn"
                android:textColor="@color/text_foreground"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStaffClinicSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="An Nhiên"
                android:textColor="@color/text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Thanh chuyển đổi trạng thái (Mặc định / Đang tải / Không khớp / Lỗi) -->
    <LinearLayout
        android:id="@+id/layoutStateToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutStaffAppBar"
        android:background="@color/surface_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:letterSpacing="0.06"
            android:text="CHẾ ĐỘ:"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipStateDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Mặc định"
                    android:textColor="@color/white"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipStateLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Đang tải"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipStateEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Không khớp"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipStateError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:text="Lỗi"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 3. Khu vực Tìm kiếm & Bộ lọc Chips -->
    <LinearLayout
        android:id="@+id/layoutSearchAndFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutStateToggle"
        android:background="@color/surface_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- Ô Tìm kiếm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/text_muted" />

            <EditText
                android:id="@+id/etStaffSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Tìm theo tên bé, chủ nuôi hoặc mã lịch"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_foreground"
                android:textColorHint="@color/text_muted"
                android:textSize="13.5sp" />

            <ImageView
                android:id="@+id/btnFilterSliders"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:clickable="true"
                android:contentDescription="@null"
                android:focusable="true"
                android:src="@drawable/ic_sliders"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Hàng Filter Chips cuộn ngang -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="Tất cả · 6"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipFilterPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="Chờ xác nhận · 2"
                    android:textColor="@color/white"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipFilterConfirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="Đã xác nhận · 2"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipFilterCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="Đã hoàn thành · 1"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipFilterNoShow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="Không đến · 1"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 4. Thân nội dung chính cuộn dọc -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollStaffAppointmentsBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavStaff"
        android:layout_below="@id/layoutSearchAndFilter"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ===================== A. TRẠNG THÁI MẶC ĐỊNH ===================== -->
            <LinearLayout
                android:id="@+id/layoutDefaultContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="4dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <!-- Tiêu đề ngày & số lượng chờ duyệt -->
                <TextView
                    android:id="@+id/tvSectionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="-0.01"
                    android:text="Thứ 2, 27/10/2026 · 2 yêu cầu chờ duyệt"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Danh sách thẻ lịch hẹn -->
                <LinearLayout
                    android:id="@+id/layoutApptList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Nút Tải lịch hẹn cũ hơn -->
                <Button
                    android:id="@+id/btnLoadOlder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_outline"
                    android:letterSpacing="-0.01"
                    android:stateListAnimator="@null"
                    android:text="Tải lịch hẹn cũ hơn"
                    android:textAllCaps="false"
                    android:textColor="@color/text_foreground"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===================== B. TRẠNG THÁI ĐANG TẢI (SKELETON) ===================== -->
            <LinearLayout
                android:id="@+id/layoutLoadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <!-- Header loading có spinner -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/brand_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Đang tải lịch hẹn…"
                        android:textColor="@color/text_muted"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Skeleton Card 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_clinic"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="140dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_skeleton_rect" />

                            <View
                                android:layout_width="180dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_skeleton_rect" />

                            <View
                                android:layout_width="90dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton_rect" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Skeleton Card 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_clinic"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="120dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_skeleton_rect" />

                            <View
                                android:layout_width="160dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_skeleton_rect" />

                            <View
                                android:layout_width="100dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton_rect" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Skeleton Card 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_card_clinic"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_skeleton_rect" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="150dp"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_skeleton_rect" />

                            <View
                                android:layout_width="190dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/bg_skeleton_rect" />

                            <View
                                android:layout_width="80dp"
                                android:layout_height="12dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_skeleton_rect" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== C. TRẠNG THÁI KHÔNG KHỚP (EMPTY / NO MATCH) ===================== -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="54dp"
                android:paddingEnd="32dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <!-- Vòng tròn viền nét đứt icon Kính lúp -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_empty_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="-0.02"
                    android:text="Không có lịch hẹn phù hợp"
                    android:textColor="@color/text_foreground"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Thử đổi bộ lọc trạng thái hoặc xóa tìm kiếm để xem cả ngày."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEmptyShowAll"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_btn_primary"
                    android:letterSpacing="-0.01"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:stateListAnimator="@null"
                    android:text="Xem tất cả trạng thái"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ===================== D. TRẠNG THÁI LỖI (ERROR) ===================== -->
            <LinearLayout
                android:id="@+id/layoutErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="54dp"
                android:paddingEnd="32dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <!-- Vòng tròn đỏ nhạt icon Cảnh báo tam giác -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_error_circle">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_alert_triangle"
                        app:tint="@color/status_destructive_ink" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="-0.02"
                    android:text="Không tải được danh sách lịch hẹn"
                    android:textColor="@color/text_foreground"
                    android:textSize="16.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Lịch của phòng khám chưa tải được. Kiểm tra kết nối rồi thử lại."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <!-- Nút Thử lại (Outline với icon refresh) -->
                <LinearLayout
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_btn_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/text_foreground" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="-0.01"
                        android:text="Thử lại"
                        android:textColor="@color/text_foreground"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 5. Thanh điều hướng đáy dành riêng cho Nhân viên (3 tab cố định) -->
    <LinearLayout
        android:id="@+id/bottomNavStaff"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_card"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tab 1: Hôm nay -->
        <LinearLayout
            android:id="@+id/navStaffToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Hôm nay"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: Lịch hẹn (ACTIVE) -->
        <LinearLayout
            android:id="@+id/navStaffAppointments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_bottom_nav_active_pill">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar_days"
                    app:tint="@color/brand_primary" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lịch hẹn"
                android:textColor="@color/brand_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 3: Khung giờ -->
        <LinearLayout
            android:id="@+id/navStaffSlots"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_paw"
                app:tint="@color/text_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Khung giờ"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
