<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_home_bg">

    <!-- Nội dung chính cuộn được -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="160dp">

            <!-- 1. Header: Tiêu đề 22sp Bold bên trái + Nút Pill '+ Thêm mới' Coral bên phải -->
            <LinearLayout
                android:id="@+id/layoutTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <!-- Nút Back (Chỉ hiện ở Bước 3/4 Đặt lịch) -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_home_icon_btn_white"
                    android:contentDescription="Quay lại"
                    android:elevation="0dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_left"
                    android:visibility="gone"
                    app:tint="@color/ds_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPetsScreenTitle"
                        style="@style/TextAppearance.PetCare.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/open_sans_bold"
                        android:maxLines="1"
                        android:text="Thú cưng của tôi"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/open_sans_bold" />

                    <TextView
                        android:id="@+id/tvSubtitleBooking"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:text="Bước 3/4"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Nút chữ phẳng '+ Thêm mới' màu #C85428 (không ép chật tiêu đề, không tranh điểm nhấn với CTA đáy) -->
                <LinearLayout
                    android:id="@+id/btnAddPetTop"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/ds_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:includeFontPadding="false"
                        android:text="Thêm mới"
                        android:textColor="@color/ds_primary"
                        android:textSize="13.5sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2A. TRẠNG THÁI CÓ THÚ CƯNG -->
            <LinearLayout
                android:id="@+id/layoutPetsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="4dp"
                android:paddingEnd="20dp">

                <!-- Container danh sách thú cưng -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPetsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- Ẩn khi đã có thú cưng (tránh trùng nút + Thêm mới góc trên phải) -->
                <LinearLayout
                    android:id="@+id/cardAddOtherPet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_add_pet_pill_borderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_home_icon_btn_white">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/ds_primary_dark" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.PetCare.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thêm thú cưng khác"
                            android:textColor="@color/ds_primary_dark" />

                        <TextView
                            style="@style/TextAppearance.PetCare.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Lưu thông tin để đặt lịch khám nhanh chóng" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 2B. TRẠNG THÁI RỖNG (Empty State) -->
            <LinearLayout
                android:id="@+id/layoutPetsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_home_card_static"
                android:elevation="0dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_corgi_running" />

                <TextView
                    style="@style/TextAppearance.PetCare.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Chưa có hồ sơ thú cưng nào" />

                <TextView
                    style="@style/TextAppearance.PetCare.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:text="Thêm bé đầu tiên để quản lý sổ sức khỏe và đặt lịch khám thuận tiện hơn." />

                <android.widget.Button
                    android:id="@+id/btnAddFirstPet"
                    style="@style/TextAppearance.PetCare.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_btn_pill_coral"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:stateListAnimator="@null"
                    android:text="+ Thêm thú cưng"
                    android:textAllCaps="false" />

                <TextView
                    android:id="@+id/btnBackToHome"
                    style="@style/Widget.PetCare.SectionAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Về trang chủ" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. Khu vực cố định dưới đáy: Sticky Bottom Bar (khi đặt lịch) & Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <!-- Sticky Bar Đặt lịch (Bước 3/4) -->
        <LinearLayout
            android:id="@+id/layoutStickyBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_surface"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.PetCare.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khám cho" />

                <TextView
                    android:id="@+id/tvSelectedPetName"
                    style="@style/TextAppearance.PetCare.CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Mochi" />
            </LinearLayout>

            <android.widget.Button
                android:id="@+id/btnContinue"
                style="@style/TextAppearance.PetCare.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:text="Tiếp tục"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Bottom Navigation Bar 4 tab (Tab 'Thú cưng' highlight nền Soft Peach #FCE9E2 & icon Coral #B95740) -->
        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/ds_surface"
            android:elevation="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tab 1: Trang chủ -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_home"
                        app:tint="@color/ds_text_secondary" />
                </FrameLayout>

                <TextView
                    style="@style/TextAppearance.PetCare.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Trang chủ"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Tab 2: Phòng khám -->
            <LinearLayout
                android:id="@+id/navClinics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_stethoscope"
                        app:tint="@color/ds_text_secondary" />
                </FrameLayout>

                <TextView
                    style="@style/TextAppearance.PetCare.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Phòng khám"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Tab 3: Lịch hẹn -->
            <LinearLayout
                android:id="@+id/navAppointments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar_days"
                        app:tint="@color/ds_text_secondary" />
                </FrameLayout>

                <TextView
                    style="@style/TextAppearance.PetCare.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Lịch hẹn"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Tab 4: Thú cưng (ACTIVE) -->
            <LinearLayout
                android:id="@+id/navPets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_bottom_nav_active_pill">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_paw"
                        app:tint="@color/ds_primary_dark" />
                </FrameLayout>

                <TextView
                    style="@style/TextAppearance.PetCare.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="Thú cưng"
                    android:textColor="@color/ds_primary_dark"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
