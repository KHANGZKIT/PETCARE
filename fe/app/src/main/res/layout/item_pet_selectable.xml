<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPetCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_service_card_default"
    android:clickable="true"
    android:elevation="3dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar thú cưng bo tròn 18dp có viền nhẹ -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPetAvatar"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:contentDescription="@null"
        android:padding="1dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_pet_mochi"
        app:shapeAppearanceOverlay="@style/RoundedCorner16"
        app:strokeColor="@color/stroke_border"
        app:strokeWidth="1dp" />

    <!-- Thông tin bé (Pet Passport Style) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPetName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_foreground"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Mochi" />

        <TextView
            android:id="@+id/tvPetBreed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_muted"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="Chó · Pomeranian" />

        <!-- Hàng thẻ thông tin nhỏ có màu sắc ấm áp: Tuổi, Giới tính, Cân nặng -->
        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPetSpeciesBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_service_icon"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/brand_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🐾 Mèo" />

            <TextView
                android:id="@+id/tvPetStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_gray"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/brand_primary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="🟢 Sẵn sàng khám" />

            <TextView
                android:id="@+id/tvPetAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_gray"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2 tuổi" />

            <TextView
                android:id="@+id/tvPetSex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_service_icon_amber"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/warm_amber_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="♀ Cái" />

            <TextView
                android:id="@+id/tvPetWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_service_icon_coral"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/warm_coral_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3,4 kg" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nút Xóa thú cưng trực tiếp (khi ở chế độ quản lý tab Thú cưng) -->
    <FrameLayout
        android:id="@+id/btnDeletePetDirect"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_floating_glass_btn_light"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="Xóa thú cưng"
            android:src="@drawable/ic_trash"
            app:tint="@color/status_destructive" />
    </FrameLayout>

    <!-- Vòng tròn radio chọn (khi ở trong luồng đặt lịch khám) -->
    <ImageView
        android:id="@+id/ivPetCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/bg_radio_unselected" />
</LinearLayout>
