<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slotRowContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_clinic"
    android:clickable="true"
    android:elevation="0dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvSlotTime"
        android:layout_width="62dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_shortcut_icon_cream"
        android:fontFamily="@font/open_sans_bold"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:text="10:00"
        android:textColor="@color/ds_text_primary"
        android:textSize="13.5sp"
        app:fontFamily="@font/open_sans_bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSlotPrimaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_semibold"
            android:maxLines="1"
            android:text="Đang mở nhận đặt lịch"
            android:textColor="@color/ds_text_primary"
            android:textSize="14sp"
            app:fontFamily="@font/open_sans_semibold" />

        <TextView
            android:id="@+id/tvSlotSecondaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_regular"
            android:maxLines="1"
            android:text="Khung 30 phút"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSlotBookedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_semibold"
        android:includeFontPadding="false"
        android:text="● Đã đặt"
        android:textColor="@color/ds_primary"
        android:textSize="12sp"
        android:visibility="gone"
        app:fontFamily="@font/open_sans_semibold" />

    <FrameLayout
        android:id="@+id/btnToggleLock"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_chip_inactive"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            app:tint="@color/ds_primary" />
    </FrameLayout>

</LinearLayout>
