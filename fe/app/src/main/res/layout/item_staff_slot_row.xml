<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slotRowContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_clinic"
    android:clickable="true"
    android:clipToOutline="true"
    android:elevation="0dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvSlotTime"
        android:layout_width="62dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_service_icon"
        android:gravity="center"
        android:letterSpacing="-0.01"
        android:text="10:00"
        android:textColor="@color/brand_ink"
        android:fontFamily="@font/open_sans_semibold"
        android:textSize="13.5sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSlotPrimaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:text="Đang mở nhận đặt lịch"
            android:textColor="@color/text_foreground"
            android:fontFamily="@font/open_sans_medium"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSlotSecondaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Khung 30 phút"
            android:textColor="@color/text_muted"
            android:fontFamily="@font/open_sans_regular"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSlotBookedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_booked"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="• Đã đặt"
        android:textColor="@color/brand_ink"
        android:fontFamily="@font/open_sans_medium"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/btnToggleLock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_btn_outline"
        android:clickable="true"
        android:elevation="0dp"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock"
            app:tint="@color/brand_primary" />
    </FrameLayout>

</LinearLayout>
