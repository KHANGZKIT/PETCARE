<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_home_bg"
    android:orientation="vertical">

    <!-- 1. Top Bar cố định ngoài vùng cuộn; dùng FrameLayout để layout_gravity tôn trọng paddingTop từ WindowInsets -->
    <FrameLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_home_icon_btn_white"
            android:contentDescription="Quay lại"
            android:elevation="0dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/ds_text_primary" />

        <TextView
            android:id="@+id/tvAddPetScreenTitle"
            style="@style/TextAppearance.PetCare.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/open_sans_bold"
            android:text="Thêm thú cưng mới"
            android:textColor="@color/ds_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:fontFamily="@font/open_sans_bold" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutAddPetRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="36dp">

        <!-- 2. Upload Avatar: Vòng tròn nét đứt 104dp #E6C7BC + nền Soft Peach #FCE9E2 + icon Camera #B95740 -->
        <LinearLayout
            android:id="@+id/sectionUploadAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btnUploadAvatar"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_upload_avatar_dashed"
                android:clickable="true"
                android:contentDescription="Tải ảnh thú cưng"
                android:focusable="true">

                <FrameLayout
                    android:id="@+id/layoutCameraPlaceholder"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_home_avatar_peach">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/ds_primary_dark" />
                </FrameLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivSelectedAvatarPreview"
                    android:layout_width="94dp"
                    android:layout_height="94dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/CircleImage"
                    app:strokeWidth="0dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvUploadAvatarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/open_sans_regular"
                android:text="Tải ảnh thú cưng"
                android:textColor="@color/ds_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Thông báo lỗi nội tuyến nếu có -->
        <LinearLayout
            android:id="@+id/layoutErrorBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_notice_danger"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_alert_circle"
                app:tint="@color/status_destructive_ink" />

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/open_sans_medium"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/status_destructive_ink"
                android:textSize="13sp"
                tools:text="Vui lòng nhập tên thú cưng của bạn" />
        </LinearLayout>

        <!-- 3. Form Container: Khối card trắng #FFFFFF bo góc 24dp, padding 20dp, không viền đậm -->
        <LinearLayout
            android:id="@+id/layoutFormSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_form_card_24"
            android:elevation="0dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Trường 1: Tên thú cưng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_medium"
                android:text="Tên thú cưng"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etPetName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field_14"
                android:fontFamily="@font/open_sans_regular"
                android:hint="Ví dụ: Mochi, Miu Miu..."
                android:inputType="textPersonName|textCapWords"
                android:maxLength="100"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ds_text_primary"
                android:textColorHint="@color/ds_text_secondary"
                android:textSize="14.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/open_sans_regular"
                android:text="Bắt buộc"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp" />

            <!-- Trường 2: Loài thú cưng (Pill Selector: Chó · Mèo · Khác) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/open_sans_medium"
                android:text="Loài thú cưng"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- Pill 1: Chó -->
                <LinearLayout
                    android:id="@+id/chipDog"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_species_pill_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/ivChipDog"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_paw_minimal"
                        app:tint="@color/ds_primary_dark" />

                    <TextView
                        android:id="@+id/tvChipDog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/open_sans_semibold"
                        android:includeFontPadding="false"
                        android:text="Chó"
                        android:textColor="@color/ds_primary_dark"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Pill 2: Mèo -->
                <LinearLayout
                    android:id="@+id/chipCat"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_species_pill_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/ivChipCat"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cat_minimal"
                        app:tint="@color/ds_text_secondary" />

                    <TextView
                        android:id="@+id/tvChipCat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:includeFontPadding="false"
                        android:text="Mèo"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- Pill 3: Khác -->
                <LinearLayout
                    android:id="@+id/chipOther"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_species_pill_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/ivChipOther"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_paw"
                        app:tint="@color/ds_text_secondary" />

                    <TextView
                        android:id="@+id/tvChipOther"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:includeFontPadding="false"
                        android:text="Khác"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Trường 3: Giống (1 dòng riêng) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/open_sans_medium"
                android:text="Giống"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etPetBreed"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field_14"
                android:fontFamily="@font/open_sans_regular"
                android:hint="VD: Pomeranian, Mèo Anh lông ngắn..."
                android:inputType="textCapWords"
                android:maxLength="100"
                android:singleLine="true"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ds_text_primary"
                android:textColorHint="@color/ds_text_secondary"
                android:textSize="14sp" />

            <!-- Trường 4: Giới tính (2 chip chọn ngang: Đực / Cái) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/open_sans_medium"
                android:text="Giới tính"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/chipMale"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_species_pill_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvChipMale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_semibold"
                        android:includeFontPadding="false"
                        android:text="Đực"
                        android:textColor="@color/ds_primary"
                        android:textSize="13.5sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chipFemale"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_species_pill_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvChipFemale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_medium"
                        android:includeFontPadding="false"
                        android:text="Cái"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Trường 5: Hàng 2 cột đều nhau — Tuổi (trái) & Cân nặng kg (phải) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_medium"
                        android:text="Tuổi"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etPetAge"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field_14"
                        android:fontFamily="@font/open_sans_regular"
                        android:hint="VD: 8 tháng, 2 tuổi"
                        android:inputType="text"
                        android:maxLength="50"
                        android:singleLine="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/ds_text_primary"
                        android:textColorHint="@color/ds_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_medium"
                        android:text="Cân nặng (kg)"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etPetWeight"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field_14"
                        android:fontFamily="@font/open_sans_regular"
                        android:fontFeatureSettings="tnum"
                        android:hint="VD: 4.2"
                        android:inputType="numberDecimal"
                        android:maxLength="6"
                        android:singleLine="true"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/ds_text_primary"
                        android:textColorHint="@color/ds_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Trường 6: Ghi chú sức khỏe (tùy chọn, multiline) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/open_sans_medium"
                android:text="Ghi chú (tùy chọn)"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etPetNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_field_14"
                android:fontFamily="@font/open_sans_regular"
                android:gravity="top|start"
                android:hint="Dị ứng, tiền sử bệnh hoặc lưu ý khi khám..."
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingMultiplier="1.2"
                android:maxLength="500"
                android:minHeight="84dp"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:textColor="@color/ds_text_primary"
                android:textColorHint="@color/ds_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 4. Nút hành động: 'Lưu thú cưng' (52dp, Pill, #B95740) & 'Hủy' (14sp Medium #6F6662) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="20dp">

            <android.widget.Button
                android:id="@+id/btnSavePet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_btn_primary"
                android:fontFamily="@font/open_sans_semibold"
                android:stateListAnimator="@null"
                android:text="Lưu thú cưng"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/open_sans_medium"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Hủy"
            android:textColor="@color/ds_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/btnDeletePet"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_notice_danger"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_alert_triangle"
                app:tint="@color/status_destructive_ink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:text="Xóa hồ sơ thú cưng"
                android:textColor="@color/status_destructive_ink"
                android:textSize="14sp"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
