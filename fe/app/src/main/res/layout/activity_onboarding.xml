<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutRootOnboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <!-- Decorative Soft Pastel Accents in Background (Subtle & Restrained) -->
    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="-30dp"
        android:layout_marginTop="32dp"
        android:alpha="0.35"
        android:background="@drawable/bg_service_icon_amber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginEnd="-20dp"
        android:layout_marginTop="80dp"
        android:alpha="0.4"
        android:background="@drawable/bg_service_icon_coral"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 1. Top Branding Header: Cute Minimal Paw Icon + "PETCARE" -->
    <LinearLayout
        android:id="@+id/layoutHeaderBranding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAppLogoPaw"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_paw_minimal"
            app:tint="@color/ds_primary"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvAppBrandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/font_be_vietnam_pro"
            android:letterSpacing="0.08"
            android:text="PETCARE"
            android:textColor="@color/ds_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Mascot Hero: Real Cute 2D Puppy PNG Mascot (Peeking naturally over card) -->
    <FrameLayout
        android:id="@+id/layoutHeroPet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="-16dp"
        app:layout_constraintBottom_toTopOf="@+id/cardWelcomeContent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderBranding">

        <ImageView
            android:id="@+id/ivPeekingDog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="PETCARE Mascot"
            android:scaleType="fitCenter"
            android:src="@drawable/mascot_petcare_intro" />
    </FrameLayout>

    <!-- 3. Welcome Content Card (Smooth Rounded Top Corners 28dp, Pure White Surface) -->
    <LinearLayout
        android:id="@+id/cardWelcomeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_onboarding_card"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Title: Chăm sóc tốt hơn Cho thú cưng của bạn -->
        <TextView
            android:id="@+id/tvWelcomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/font_be_vietnam_pro"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:text="Chăm sóc tốt hơn\nCho thú cưng của bạn"
            android:textColor="@color/ds_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Subtitle description: Exact Vietnamese copy -->
        <TextView
            android:id="@+id/tvWelcomeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/font_be_vietnam_pro"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Tìm phòng khám phù hợp và đặt lịch khám cho bé yêu chỉ trong vài bước."
            android:textColor="@color/ds_text_secondary"
            android:textSize="14.5sp" />

        <!-- Primary Action Button: "Bắt đầu" (Pill 54dp, #B95740 with pressed state) -->
        <FrameLayout
            android:id="@+id/btnGetStarted"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_btn_onboarding_coral"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:text="Bắt đầu"
                android:textColor="@color/white"
                android:textSize="16.5sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Secondary Action: "Đã có tài khoản? Đăng nhập" -->
        <TextView
            android:id="@+id/tvLoginPrompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_be_vietnam_pro"
            android:minHeight="@dimen/touch_target_min"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="Đã có tài khoản? Đăng nhập"
            android:textColor="@color/ds_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
