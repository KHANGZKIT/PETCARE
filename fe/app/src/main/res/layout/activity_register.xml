<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollRegisterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutRegisterBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="36dp">

        <!-- 1. Top Navigation & Brand Header -->
        <LinearLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip_inactive"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/ds_text_primary"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_paw_minimal"
                    app:tint="@color/ds_primary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:letterSpacing="0.06"
                    android:text="PETCARE"
                    android:textColor="@color/ds_primary"
                    android:textSize="16sp"
                    app:fontFamily="@font/open_sans_bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivRegisterMascot"
                android:layout_width="64dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="PETCARE Mascot"
                android:scaleType="fitCenter"
                android:src="@drawable/mascot_corgi_wave" />
        </LinearLayout>

        <!-- 2. Screen Title & Subtitle -->
        <LinearLayout
            android:id="@+id/layoutRegisterHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PetCare.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:text="Tạo tài khoản mới"
                android:textColor="@color/ds_text_primary"
                android:textSize="23sp"
                app:fontFamily="@font/open_sans_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_regular"
                android:lineSpacingExtra="2dp"
                android:text="Quản lý hồ sơ thú cưng và đặt lịch khám nhanh chóng."
                android:textColor="@color/ds_text_secondary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- 3. Form Card (Warm Tactile 14dp White Card + 1dp Hairline) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_clinic"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Field 1: Họ và tên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semibold"
                android:text="Họ và tên *"
                android:textColor="@color/ds_text_primary"
                android:textSize="13.5sp"
                app:fontFamily="@font/open_sans_semibold" />

            <LinearLayout
                android:id="@+id/boxFullName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivFullNameIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/open_sans_regular"
                    android:hint="Nguyễn Văn A"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvErrorFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/open_sans_medium"
                    android:text="Vui lòng nhập họ và tên của bạn"
                    android:textColor="@color/ds_error"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Field 2: Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/open_sans_semibold"
                android:text="Email *"
                android:textColor="@color/ds_text_primary"
                android:textSize="13.5sp"
                app:fontFamily="@font/open_sans_semibold" />

            <LinearLayout
                android:id="@+id/boxEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivEmailIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/open_sans_regular"
                    android:hint="ten@email.com"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivEmailStatusIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvEmailHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/open_sans_medium"
                    android:text="Email chưa đúng định dạng"
                    android:textColor="@color/ds_error"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Field 3: Số điện thoại -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/open_sans_semibold"
                android:text="Số điện thoại *"
                android:textColor="@color/ds_text_primary"
                android:textSize="13.5sp"
                app:fontFamily="@font/open_sans_semibold" />

            <LinearLayout
                android:id="@+id/boxPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/ivPhoneIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/open_sans_regular"
                    android:fontFeatureSettings="tnum"
                    android:hint="0912 345 678"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvErrorPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/open_sans_medium"
                    android:text="Vui lòng nhập số điện thoại hợp lệ"
                    android:textColor="@color/ds_error"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Field 4: Mật khẩu -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="Mật khẩu *"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="13.5sp"
                    app:fontFamily="@font/open_sans_semibold" />

                <TextView
                    android:id="@+id/tvTogglePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/open_sans_semibold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp"
                    android:text="Hiện"
                    android:textColor="@color/ds_primary"
                    android:textSize="12.5sp"
                    app:fontFamily="@font/open_sans_semibold" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/boxPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/open_sans_regular"
                    android:hint="Tối thiểu 8 ký tự, có số"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutHintPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPasswordStatusIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    android:visibility="gone"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvPasswordHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:text="Ít nhất 8 ký tự, gồm ít nhất 1 chữ số"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Field 5: Nhập lại mật khẩu -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="Nhập lại mật khẩu *"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="13.5sp"
                    app:fontFamily="@font/open_sans_semibold" />

                <TextView
                    android:id="@+id/tvToggleConfirmPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/open_sans_semibold"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="4dp"
                    android:text="Hiện"
                    android:textColor="@color/ds_primary"
                    android:textSize="12.5sp"
                    app:fontFamily="@font/open_sans_semibold" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/boxConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/open_sans_regular"
                    android:hint="Nhập lại mật khẩu"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="14.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvErrorConfirmPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/open_sans_medium"
                    android:text="Mật khẩu xác nhận chưa khớp"
                    android:textColor="@color/ds_error"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/noticeServerFailure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_notice_danger"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/open_sans_medium"
                    android:text="Có lỗi xảy ra khi tạo tài khoản."
                    android:textColor="@color/ds_error"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Primary CTA Button (12dp radius) -->
            <FrameLayout
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:elevation="0dp"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:indeterminateTint="@color/white"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvBtnRegisterText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_semibold"
                        android:includeFontPadding="false"
                        android:text="Tạo tài khoản"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Compact privacy caption -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/open_sans_regular"
            android:gravity="center"
            android:text="Thông tin của bạn chỉ dùng để xác nhận lịch khám thú cưng."
            android:textColor="@color/ds_text_secondary"
            android:textSize="11.5sp" />

        <!-- Footer: "Đã có tài khoản? Đăng nhập" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="44dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/open_sans_regular"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="Đã có tài khoản? Đăng nhập"
                android:textColor="@color/ds_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
