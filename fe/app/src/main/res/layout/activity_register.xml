<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollRegisterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ds_background">

    <LinearLayout
        android:id="@+id/layoutRegisterBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <!-- 1. Top Navigation & Brand Header (Nút quay lại cùng dòng với PETCARE) -->
        <LinearLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button [ < ] -->
            <FrameLayout
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_outline"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/ds_text_primary"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <!-- Brand Logo & Text: Paw + PETCARE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_paw_minimal"
                    app:tint="@color/ds_primary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:letterSpacing="0.06"
                    android:text="PETCARE"
                    android:textColor="@color/ds_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Compact Mascot Detail (Cute 2D) -->
            <ImageView
                android:id="@+id/ivRegisterMascot"
                android:layout_width="66dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="PETCARE Mascot"
                android:scaleType="fitCenter"
                android:src="@drawable/mascot_petcare_intro" />
        </LinearLayout>

        <!-- 2. Screen Title & Subtitle -->
        <LinearLayout
            android:id="@+id/layoutRegisterHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- Screen Title: Tạo tài khoản mới -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:text="Tạo tài khoản mới"
                android:textColor="@color/ds_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:lineSpacingExtra="3dp"
                android:text="Đăng ký để quản lý hồ sơ và đặt lịch khám cho thú cưng."
                android:textColor="@color/ds_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 2. Form Input Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Field 1: Họ và tên -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:text="Họ và tên *"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/boxFullName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_primary"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/ivFullNameIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_user"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:hint="Nguyễn Văn A"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="15.5sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvErrorFullName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:text="Vui lòng nhập họ và tên của bạn"
                    android:textColor="@color/ds_error"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Field 2: Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:text="Email *"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/boxEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_primary"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/ivEmailIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:hint="ten@email.com"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="15.5sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/ivEmailStatusIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvEmailHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:text="Email chưa đúng định dạng (ví dụ: ten@email.com)"
                    android:textColor="@color/ds_error"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Field 3: Số điện thoại -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:text="Số điện thoại *"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/boxPhone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_primary"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/ivPhoneIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:hint="0912 345 678"
                    android:inputType="phone"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="15.5sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvErrorPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:text="Vui lòng nhập số điện thoại hợp lệ (từ 9 - 11 chữ số)"
                    android:textColor="@color/ds_error"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Field 4: Mật khẩu -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:text="Mật khẩu *"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTogglePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp"
                    android:text="Hiện"
                    android:textColor="@color/ds_primary_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/boxPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_primary"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:hint="Tối thiểu 8 ký tự, có số"
                    android:inputType="textPassword"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="15.5sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutHintPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivPasswordStatusIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvPasswordHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:text="Ít nhất 8 ký tự, gồm ít nhất 1 chữ số"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Field 5: Nhập lại mật khẩu -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:text="Nhập lại mật khẩu *"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvToggleConfirmPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp"
                    android:text="Hiện"
                    android:textColor="@color/ds_primary_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/boxConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_primary"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/ds_text_secondary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:hint="Nhập lại mật khẩu để xác nhận"
                    android:inputType="textPassword"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:textSize="15.5sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutErrorConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/ds_error"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvErrorConfirmPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:text="Mật khẩu xác nhận chưa khớp"
                    android:textColor="@color/ds_error"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Policy Note (Không dùng checkbox giả) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_btn_outline"
            android:padding="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/ds_primary"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:text="Khi tạo tài khoản, thông tin của bạn được bảo mật tuyệt đối và chỉ dùng để quản lý lịch khám thú cưng tại các cơ sở bạn lựa chọn."
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2.5dp" />
        </LinearLayout>

        <!-- 4. Notice Banner (Lỗi từ Backend) -->
        <LinearLayout
            android:id="@+id/noticeServerFailure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_notice_danger"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_alert_circle"
                app:tint="@color/ds_error"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:text="Có lỗi xảy ra khi tạo tài khoản."
                android:textColor="@color/ds_error"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. Primary CTA Button: "Tạo tài khoản" -->
        <FrameLayout
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_primary"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvBtnRegisterText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/font_be_vietnam_pro"
                    android:text="Tạo tài khoản"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- 6. Footer: "Đã có tài khoản? Đăng nhập" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/font_be_vietnam_pro"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="Đã có tài khoản? Đăng nhập"
                android:textColor="@color/ds_text_secondary"
                android:textSize="14.5sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
