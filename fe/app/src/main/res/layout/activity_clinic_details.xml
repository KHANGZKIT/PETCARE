<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- Scrollable Body Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Header with Cover Image & Top Bar Controls -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="244dp">

                <!-- Ảnh bìa phòng khám -->
                <ImageView
                    android:id="@+id/ivClinicCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_clinic_cover" />

                <!-- Gradient phủ trên ảnh để nút top bar nổi bật -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/bg_gradient_cover_top" />

                <!-- Floating Top Bar Actions -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <!-- Nút quay lại (Nền tối mờ kính viền trắng) -->
                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_floating_glass_btn_dark"
                        android:contentDescription="Quay lại"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_chevron_left"
                        android:tint="@color/white" />

                    <!-- Nhóm nút góc phải (Chia sẻ + Lưu yêu thích) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnShare"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_floating_glass_btn_light"
                            android:contentDescription="Chia sẻ"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_share"
                            android:tint="@color/text_foreground" />

                        <ImageButton
                            android:id="@+id/btnHeart"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_floating_glass_btn_light"
                            android:contentDescription="Lưu phòng khám"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_heart"
                            android:tint="@color/text_foreground" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Badge trạng thái mở cửa góc dưới ảnh bìa -->
                <TextView
                    android:id="@+id/tvCoverStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="28dp"
                    android:background="@drawable/bg_badge_open_glass"
                    android:letterSpacing="0.06"
                    android:text="ĐANG MỞ CỬA · ĐẾN 20:00"
                    android:textColor="@color/status_success_ink"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 2. Thẻ nội dung chính (Bo tròn 28dp phủ lấn nhẹ lên ảnh bìa) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:background="@drawable/bg_clinic_details_body"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="120dp">

                <!-- Tên phòng khám -->
                <TextView
                    android:id="@+id/tvClinicName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:lineSpacingExtra="2dp"
                    android:text="Phòng khám Thú y An Nhiên"
                    android:textColor="@color/text_foreground"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Địa chỉ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_map_pin"
                        android:tint="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvClinicAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="42 Nguyễn Huệ, Quận 1, TP.HCM"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Pill Đánh giá & Khoảng cách -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Pill Đánh giá -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill_white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_star_filled"
                            android:tint="@color/status_warning" />

                        <TextView
                            android:id="@+id/tvClinicRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="4.8"
                            android:textColor="@color/text_foreground"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvClinicReviews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="(214 đánh giá)"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Pill Khoảng cách -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_pill_white"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_navigation"
                            android:tint="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvClinicDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="1,2 km"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2 Nút thao tác nhanh (Gọi phòng khám & Chỉ đường) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnCallClinic"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_action_chip_teal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/brand_ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Gọi phòng khám"
                            android:textColor="@color/brand_ink"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnDirections"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_action_chip_teal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_navigation"
                            android:tint="@color/brand_ink" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Chỉ đường"
                            android:textColor="@color/brand_ink"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Giới thiệu phòng khám -->
                <TextView
                    android:id="@+id/tvClinicAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Phòng khám nhỏ cho chó và mèo. Khám tổng quát, tiêm phòng, nha khoa và tiểu phẫu, có phòng xét nghiệm tại chỗ và khu thăm khám yên tĩnh, ít gây căng thẳng cho thú cưng."
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />

                <!-- Thẻ Thông tin chi tiết (Giờ mở cửa, Cấp cứu, Ngôn ngữ, SĐT) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card_clinic"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Hàng 1: Giờ mở cửa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_clock"
                                android:tint="@color/text_muted" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Giờ mở cửa"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvInfoHours"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Thứ 2 – CN · 08:00 – 20:00"
                            android:textColor="@color/text_foreground"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#F2F1EE" />

                    <!-- Hàng 2: Tiếp nhận cấp cứu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="23dp"
                            android:text="Tiếp nhận cấp cứu"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvInfoEmergency"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Đến 22:00"
                            android:textColor="@color/text_foreground"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#F2F1EE" />

                    <!-- Hàng 3: Ngôn ngữ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="23dp"
                            android:text="Ngôn ngữ"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvInfoLanguages"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="Tiếng Việt, tiếng Anh"
                            android:textColor="@color/text_foreground"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#F2F1EE" />

                    <!-- Hàng 4: Điện thoại -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_phone"
                                android:tint="@color/text_muted" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Điện thoại"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvInfoPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="+84 28 3822 1140"
                            android:textColor="@color/text_foreground"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. Mục Dịch vụ -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Dịch vụ"
                        android:textColor="@color/text_foreground"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSeeAllServices"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Xem tất cả"
                        android:textColor="@color/brand_primary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Danh sách Dịch vụ có thể chọn -->
                <LinearLayout
                    android:id="@+id/containerServicesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <!-- 4. Bản đồ vị trí phòng khám -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_clinic"
                    android:clipToOutline="true"
                    android:orientation="vertical">

                    <!-- Khung mô phỏng bản đồ Grid với Pin tọa độ chính giữa -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="132dp"
                        android:background="@drawable/bg_map_grid">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_pin_circle"
                            android:elevation="4dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_map_pin"
                                android:tint="@color/white" />
                        </FrameLayout>
                    </FrameLayout>

                    <!-- Thông tin vị trí & Nút chỉ đường dưới bản đồ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Vị trí phòng khám"
                                android:textColor="@color/text_foreground"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvMapLocationDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="42 Nguyễn Huệ, Quận 1, TP.HCM · đi ô tô 6 phút"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnMapDirections"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_action_chip_teal"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Chỉ đường"
                            android:textColor="@color/brand_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 5. Banner thông báo Hủy lịch miễn phí -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_notice_brand"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        android:tint="@color/brand_ink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Hủy lịch miễn phí"
                            android:textColor="@color/brand_ink"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="1dp"
                            android:text="Hủy miễn phí trước giờ khám 4 tiếng. Phòng khám sẽ mở lại khung giờ của bạn ngay lập tức."
                            android:textColor="@color/brand_ink"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 6. Sticky Bottom Bar cố định phía dưới -->
    <LinearLayout
        android:id="@+id/layoutStickyBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <android.widget.Button
            android:id="@+id/btnBookAppointment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:text="Đặt lịch khám"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFastestSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Khung giờ trống gần nhất · Thứ 2 27/10 · 10:00"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>
</FrameLayout>
