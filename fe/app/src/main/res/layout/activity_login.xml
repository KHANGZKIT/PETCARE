<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- 1. Header: Logo Badge & App Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo_badge">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_paw"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="PET CARE"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_foreground"
                android:letterSpacing="-0.01" />
        </LinearLayout>

        <!-- 2. Heading & Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Chào mừng bạn trở lại"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_foreground"
            android:letterSpacing="-0.02" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Đăng nhập để đặt lịch khám, quản lý thú cưng và theo dõi lịch hẹn của bạn."
            android:textSize="13.5sp"
            android:textColor="@color/text_muted"
            android:lineSpacingExtra="3dp" />

        <!-- 3. Form Input Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <!-- Field Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_foreground" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/text_muted"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="ten@email.com"
                    android:text="lan.nguyen@example.com"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_foreground"
                    android:textColorHint="@color/text_muted"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Field Mật khẩu -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Mật khẩu"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_foreground" />

                <TextView
                    android:id="@+id/tvTogglePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Hiện"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_primary"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/ivPasswordIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/text_muted"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Nhập mật khẩu"
                    android:text="petcare2026"
                    android:inputType="textPassword"
                    android:textColor="@color/text_foreground"
                    android:textColorHint="@color/text_muted"
                    android:textSize="15sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Quên mật khẩu link -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="Quên mật khẩu?"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- 4. Notice Banner (Lỗi nhập liệu / Đăng nhập thất bại) -->
        <LinearLayout
            android:id="@+id/noticeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_notice_danger"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/ic_alert_circle"
                app:tint="@color/status_destructive_ink"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvErrorTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email hoặc mật khẩu chưa đúng"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_destructive_ink" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Kiểm tra lại thông tin, hoặc đặt lại mật khẩu."
                    android:textSize="12.5sp"
                    android:textColor="@color/status_destructive_ink"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 5. Button Đăng nhập chính -->
        <FrameLayout
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/text_muted"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvBtnLoginText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đăng nhập"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
            </LinearLayout>
        </FrameLayout>

        <!-- 6. Divider: HOẶC -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/stroke_border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="HOẶC"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.14" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/stroke_border" />
        </LinearLayout>

        <!-- 7. Button Tiếp tục với Google -->
        <LinearLayout
            android:id="@+id/btnGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_lg"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_google"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Tiếp tục với Google"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_foreground" />
        </LinearLayout>

        <!-- 8. Footer: Chưa có tài khoản? Tạo tài khoản -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có tài khoản? "
                android:textSize="13sp"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/tvGoToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tạo tài khoản"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
