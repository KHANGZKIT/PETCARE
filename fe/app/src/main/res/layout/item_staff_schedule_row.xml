<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_clinic"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Cột thời gian bên trái -->
    <LinearLayout
        android:layout_width="54dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvScheduleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.01"
            android:text="14:00"
            android:textColor="@color/text_foreground"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:letterSpacing="0.06"
            android:text="HÔM NAY"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Vạch phân tách dọc -->
    <View
        android:layout_width="1dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp"
        android:background="#F2F1EE" />

    <!-- Cột thông tin Thú cưng & Khách hàng ở giữa -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSchedulePetService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Bông · Cạo vôi &amp; chăm sóc răng"
            android:textColor="@color/text_foreground"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScheduleCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Trần Minh"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Huy hiệu trạng thái bên phải -->
    <TextView
        android:id="@+id/tvScheduleBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_badge_confirmed"
        android:text="• Đã xác nhận"
        android:textColor="@color/status_success_ink"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
