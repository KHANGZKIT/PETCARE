<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_home_card_borderless"
    android:clickable="true"
    android:elevation="0dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_shortcut_icon_cream"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvScheduleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_bold"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="14:00"
            android:textColor="@color/ds_text_primary"
            android:textSize="13.5sp"
            app:fontFamily="@font/open_sans_bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSchedulePetService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_semibold"
            android:maxLines="1"
            android:text="Bông · Cạo vôi &amp; chăm sóc răng"
            android:textColor="@color/ds_text_primary"
            android:textSize="14sp"
            app:fontFamily="@font/open_sans_semibold" />

        <TextView
            android:id="@+id/tvScheduleCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_regular"
            android:maxLines="1"
            android:text="Trần Minh"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvScheduleBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/open_sans_semibold"
        android:includeFontPadding="false"
        android:text="● Đã xác nhận"
        android:textColor="@color/ds_success"
        android:textSize="11.5sp"
        app:fontFamily="@font/open_sans_semibold" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/ds_primary" />
</LinearLayout>
