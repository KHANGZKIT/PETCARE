<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical">

    <!-- 1. App Bar: Nút Back + Tiêu đề & Khu vực (Không bị đè Status Bar) -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_btn_outline"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/text_foreground"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PetCare.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:letterSpacing="-0.01"
                android:text="Khám phá Phòng khám"
                android:textColor="@color/ds_text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                app:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvLocationSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Hệ thống cơ sở thú y"
                android:textColor="@color/brand_primary"
                android:fontFamily="@font/open_sans_medium"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. Thanh Tìm kiếm & Nút Lọc Cố định -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:elevation="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/ds_primary"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/etSearchLocation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:background="@android:color/transparent"
                    android:hint="Tìm theo tên, khu vực..."
                    android:importantForAutofill="no"
                    android:singleLine="true"
                    android:textColor="@color/ds_text_primary"
                    android:textColorHint="@color/ds_text_secondary"
                    android:fontFamily="@font/open_sans_regular"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnFilter"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:elevation="0dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sliders"
                    app:tint="@color/ds_text_primary"
                    tools:ignore="ContentDescription" />
            </FrameLayout>
        </LinearLayout>

        <!-- Thanh cuộn ngang các Chip bộ lọc (Warm Tactile: #FDF0EB + viền 1.5dp #C85428) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chip_active"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="Tất cả"
                    android:textColor="@color/ds_primary"
                    android:fontFamily="@font/open_sans_semibold"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="Đang mở cửa"
                    android:textColor="@color/ds_text_secondary"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:id="@+id/chipNearby"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:id="@+id/ivChipNearby"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_map_pin"
                        app:tint="@color/ds_text_secondary"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvChipNearby"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gần tôi"
                        android:textColor="@color/ds_text_secondary"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/chipExam"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:fontFamily="@font/open_sans_medium"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="Khám bệnh"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipVaccine"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:fontFamily="@font/open_sans_medium"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="Tiêm phòng"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipSpa"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:fontFamily="@font/open_sans_medium"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="Tắm &amp; Spa"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/chipEmergency"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="Cấp cứu 24/7"
                    android:textColor="@color/ds_text_secondary"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Khối chuyển đổi các Trạng thái (Results / Loading / Empty / Error) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ==================== TRẠNG THÁI 1: CÓ KẾT QUẢ (RESULTS) ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layoutResultsState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutResultsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <!-- Header danh sách: Số lượng phòng khám & Bộ sắp xếp -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvClinicCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="4 phòng khám"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/tvSortOption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="Sắp xếp · Gần nhất"
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="12.5sp" />
                </RelativeLayout>

                <!-- Danh sách phòng khám phẳng nguyên khối có viền 1dp #E6DFD5 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvClinicsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_card_static"
                    android:clipToOutline="true"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ==================== TRẠNG THÁI 2: ĐANG TẢI (LOADING SKELETON) ==================== -->
        <ScrollView
            android:id="@+id/layoutLoadingState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:indeterminateTint="@color/brand_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Đang tìm phòng khám gần bạn…"
                        android:textColor="@color/brand_primary"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <include layout="@layout/item_clinic_row_skeleton" />
                <include layout="@layout/item_clinic_row_skeleton" />
                <include layout="@layout/item_clinic_row_skeleton" />
            </LinearLayout>
        </ScrollView>

        <!-- ==================== TRẠNG THÁI 3: KHÔNG KẾT QUẢ (EMPTY STATE) ==================== -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:visibility="gone"
            tools:visibility="gone">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_empty_circle">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search"
                    app:tint="@color/brand_primary"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Không tìm thấy phòng khám phù hợp"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="16.5sp" />

            <TextView
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Không tìm thấy phòng khám phù hợp với từ khóa hoặc bộ lọc này. Thử mở rộng khu vực hoặc xóa bộ lọc."
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_regular"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/btnClearFilter"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Bỏ bộ lọc"
                    android:textColor="@color/white"
                    android:fontFamily="@font/open_sans_semibold"
                    android:textSize="14sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvChangeLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Đổi khu vực"
                android:textColor="@color/brand_primary"
                android:fontFamily="@font/open_sans_medium"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ==================== TRẠNG THÁI 4: LỖI MẠNG (ERROR STATE) ==================== -->
        <LinearLayout
            android:id="@+id/layoutErrorState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="56dp"
            android:paddingEnd="24dp"
            android:visibility="gone"
            tools:visibility="gone">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_error_circle">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_alert_triangle"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Không tải được danh sách phòng khám"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_bold"
                android:textSize="16.5sp" />

            <TextView
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Không kết nối được với hệ thống. Kiểm tra kết nối mạng rồi thử lại."
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_regular"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_refresh"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Thử lại"
                    android:textColor="@color/text_foreground"
                    android:fontFamily="@font/open_sans_semibold"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- Thanh điều hướng dưới cùng (Phương án B: Trang chủ · Phòng khám · Lịch hẹn · Thú cưng) -->
    <LinearLayout
        android:id="@+id/layoutBottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav_bar"
        android:elevation="0dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Tab 1: Trang chủ -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_home"
                        app:tint="@color/ds_text_secondary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Trang chủ"
                    android:textColor="@color/ds_text_secondary"
                    android:fontFamily="@font/open_sans_medium"
                    android:includeFontPadding="false"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 2: Phòng khám (Active) -->
            <LinearLayout
                android:id="@+id/navClinics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_bottom_nav_active_pill">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_stethoscope"
                        app:tint="@color/ds_primary_dark" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Phòng khám"
                    android:textColor="@color/ds_primary_dark"
                    android:fontFamily="@font/open_sans_semibold"
                    android:includeFontPadding="false"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 3: Lịch hẹn -->
            <LinearLayout
                android:id="@+id/navAppointments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar_days"
                        app:tint="@color/ds_text_secondary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lịch hẹn"
                    android:textColor="@color/ds_text_secondary"
                    android:fontFamily="@font/open_sans_medium"
                    android:includeFontPadding="false"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Tab 4: Thú cưng -->
            <LinearLayout
                android:id="@+id/navPets"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="30dp">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_paw"
                        app:tint="@color/ds_text_secondary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Thú cưng"
                    android:textColor="@color/ds_text_secondary"
                    android:fontFamily="@font/open_sans_medium"
                    android:includeFontPadding="false"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
