<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="22dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivDialogPetAvatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@color/ds_cream_tile"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_pet_mochi"
            app:shapeAppearanceOverlay="@style/RoundedCorner10"
            app:strokeWidth="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogPetName"
                style="@style/TextAppearance.PetCare.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_bold"
                android:maxLines="1"
                android:textColor="@color/ds_text_primary"
                android:textSize="16.5sp"
                app:fontFamily="@font/open_sans_bold"
                tools:text="Mochi" />

            <TextView
                android:id="@+id/tvDialogPetBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_regular"
                android:maxLines="1"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12.5sp"
                tools:text="Chó · Pomeranian" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/ds_divider_hairline" />

    <FrameLayout
        android:id="@+id/btnDialogBookForPet"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_btn_primary"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_days"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/open_sans_semibold"
                android:text="Đặt lịch khám cho bé"
                android:textColor="@color/white"
                android:textSize="13.5sp"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btnDialogDeletePet"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_danger_outline"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_x_circle"
                app:tint="@color/ds_error" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/open_sans_semibold"
                android:text="Xóa hồ sơ thú cưng"
                android:textColor="@color/ds_error"
                android:textSize="13.5sp"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/btnDialogClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/open_sans_semibold"
        android:padding="6dp"
        android:text="Đóng"
        android:textColor="@color/ds_text_secondary"
        android:textSize="13sp"
        app:fontFamily="@font/open_sans_semibold" />

</LinearLayout>
