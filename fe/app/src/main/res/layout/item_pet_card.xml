<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPetCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_home_card_borderless"
    android:clickable="true"
    android:elevation="0dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Bên trái: Ảnh đại diện thú cưng 68dp x 68dp, bo góc 10dp trên nền kem #F3EDE4 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivPetAvatar"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@color/ds_cream_tile"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/img_pet_mochi"
        app:shapeAppearanceOverlay="@style/RoundedCorner10"
        app:strokeWidth="0dp" />

    <!-- Ở giữa: Tên thú cưng + Giống + Tuổi · Giới tính (phẳng, không pill xanh) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPetName"
            style="@style/TextAppearance.PetCare.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_semibold"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="1"
            android:textColor="@color/ds_text_primary"
            android:textSize="16sp"
            app:fontFamily="@font/open_sans_semibold"
            tools:text="Miu Miu" />

        <TextView
            android:id="@+id/tvPetSpecies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/open_sans_regular"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/ds_text_secondary"
            android:textSize="13.5sp"
            tools:text="Mèo Anh lông ngắn" />

        <TextView
            android:id="@+id/tvPetHealthBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/open_sans_regular"
            android:includeFontPadding="false"
            android:text="2 tuổi · Cái"
            android:textColor="@color/ds_text_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Bên phải (Chế độ Quản lý): Xếp dọc 2 nút icon tròn 36dp x 36dp nền kem nhạt #F6F2EE -->
    <LinearLayout
        android:id="@+id/layoutPetActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btnEditPet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle_cream"
            android:clickable="true"
            android:contentDescription="Chỉnh sửa thú cưng"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_pencil"
                app:tint="@color/ds_text_primary" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnHistoryPet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_icon_circle_cream"
            android:clickable="true"
            android:contentDescription="Lịch sử khám"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock"
                app:tint="@color/ds_text_secondary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bên phải (Chế độ Đặt lịch Bước 3/4): Nút chọn Radio -->
    <ImageView
        android:id="@+id/ivPetCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/bg_radio_unselected"
        android:visibility="gone" />

</LinearLayout>
