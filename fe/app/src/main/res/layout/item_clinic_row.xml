<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_clinic"
    android:clickable="true"
    android:elevation="3dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Ảnh đại diện phòng khám 82x82dp bo góc 18dp (Ảnh thật / Illustration, không dùng icon xám) -->
    <androidx.cardview.widget.CardView
        android:layout_width="82dp"
        android:layout_height="82dp"
        app:cardBackgroundColor="@color/brand_soft"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivClinicImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_clinic_annhien"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <!-- Cột thông tin phòng khám -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Dòng 1: Tên + Mũi tên Chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClinicName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Phòng khám Thú y An Nhiên"
                android:textColor="@color/text_foreground"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/brand_primary"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- Dòng 2: Địa chỉ kèm MapPin -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_map_pin"
                app:tint="@color/brand_primary"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvClinicAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Số 12 Chùa Hà, Cầu Giấy, Hà Nội"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Dòng 3: Rating pill ấm áp + Số đánh giá & Khoảng cách -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_service_icon_amber"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star_filled"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvClinicRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="4.8"
                    android:textColor="@color/warm_amber_ink"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvClinicMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text=" · 214 đánh giá · 1,2 km"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Dòng 4: Huy hiệu Mở cửa & Giờ hoạt động -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClinicStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_open"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="● ĐANG MỞ CỬA"
                android:textColor="@color/status_success_ink"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutHoursPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_gray"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_clock"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvClinicHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="08:00 – 20:00"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
