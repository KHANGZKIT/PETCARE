<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_clinic"
    android:orientation="horizontal"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Ảnh đại diện phòng khám 76x76dp bo góc 16dp -->
    <androidx.cardview.widget.CardView
        android:layout_width="76dp"
        android:layout_height="76dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/surface_muted">

        <ImageView
            android:id="@+id/ivClinicImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_paw"
            app:tint="@color/text_muted"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <!-- Cột thông tin phòng khám -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Dòng 1: Tên + Mũi tên Chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClinicName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Phòng khám Thú y An Nhiên"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_foreground"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron_right"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- Dòng 2: Địa chỉ kèm MapPin -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_map_pin"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvClinicAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="42 Nguyễn Huệ, Quận 1, TP.HCM"
                android:textSize="11.5sp"
                android:textColor="@color/text_muted"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Dòng 3: Rating, Số đánh giá & Khoảng cách -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_star_filled"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvClinicRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="4.8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_foreground" />

            <TextView
                android:id="@+id/tvClinicMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · 214 đánh giá · 1,2 km"
                android:textSize="11.5sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- Dòng 4: Huy hiệu Mở cửa & Giờ hoạt động -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClinicStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_open"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="ĐANG MỞ CỬA"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/status_success_ink" />

            <LinearLayout
                android:id="@+id/layoutHoursPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_gray"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_clock"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvClinicHours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="08:00 – 20:00"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
