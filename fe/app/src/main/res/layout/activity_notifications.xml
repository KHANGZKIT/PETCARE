<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <!-- 1. Fixed Top Bar -->
    <LinearLayout
        android:id="@+id/layoutAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/ds_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_inactive"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/ds_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PetCare.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:text="Thông báo"
                android:textColor="@color/ds_text_primary"
                android:textSize="18sp"
                app:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/open_sans_regular"
                android:text="2 thông báo chưa đọc"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMarkAllRead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/open_sans_semibold"
            android:padding="6dp"
            android:text="Đọc tất cả"
            android:textColor="@color/ds_primary"
            android:textSize="12.5sp"
            app:fontFamily="@font/open_sans_semibold" />
    </LinearLayout>

    <!-- 2. Scrollable Notification List -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewBody"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutAppBar"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/layoutNotificationsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLabelToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:letterSpacing="0.08"
                    android:text="HÔM NAY"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="11sp"
                    app:fontFamily="@font/open_sans_semibold" />

                <LinearLayout
                    android:id="@+id/layoutGroupToday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvLabelEarlier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:letterSpacing="0.08"
                    android:text="TRƯỚC ĐÓ"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="11sp"
                    app:fontFamily="@font/open_sans_semibold" />

                <LinearLayout
                    android:id="@+id/layoutGroupEarlier"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_corgi_wave" />

                <TextView
                    style="@style/TextAppearance.PetCare.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="Bạn đã đọc hết thông báo"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="17sp"
                    app:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:maxWidth="280dp"
                    android:text="Thông báo xác nhận lịch và nhắc hẹn khám sẽ xuất hiện tại đây."
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/btnEmptyBackHome"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_semibold"
                        android:text="Về trang chủ"
                        android:textColor="@color/white"
                        android:textSize="13.5sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
