<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_gray" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.PetCare.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_bold"
                android:includeFontPadding="false"
                android:text="Chọn khu vực của bạn"
                android:textColor="@color/ds_text_primary"
                android:textSize="17sp"
                app:fontFamily="@font/open_sans_bold" />

            <TextView
                android:id="@+id/tvLocationSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_regular"
                android:text="Hiển thị phòng khám thú y gần bạn nhất"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnCloseLocationSheet"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_home_icon_btn_white"
            android:clickable="true"
            android:contentDescription="Đóng"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_x_circle"
                app:tint="@color/ds_text_secondary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Featured GPS Option -->
    <LinearLayout
        android:id="@+id/rowUseCurrentGps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_location_gps_active"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="13dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_home_icon_btn_white">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_navigation"
                app:tint="@color/ds_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGpsOptionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:text="Dùng vị trí GPS hiện tại"
                android:textColor="@color/ds_primary"
                android:textSize="14sp"
                app:fontFamily="@font/open_sans_semibold" />

            <TextView
                android:id="@+id/tvGpsOptionDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/open_sans_regular"
                android:text="Tự động định vị trên thiết bị của bạn"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivGpsCheck"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/ds_primary" />
    </LinearLayout>

    <!-- Section Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/open_sans_semibold"
        android:letterSpacing="0.06"
        android:text="KHU VỰC TẠI HÀ NỘI"
        android:textColor="@color/ds_text_secondary"
        android:textSize="11sp"
        app:fontFamily="@font/open_sans_semibold" />

    <!-- Grouped Preset Locations Card (Warm Tactile hairline style) -->
    <LinearLayout
        android:id="@+id/containerPresetLocations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_card_static"
        android:clipToOutline="true"
        android:orientation="vertical"
        tools:minHeight="180dp" />

</LinearLayout>
