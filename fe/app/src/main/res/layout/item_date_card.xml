<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDateCard"
    android:layout_width="52dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_date_card_default"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tvDateDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_medium"
        android:letterSpacing="0.04"
        android:textAllCaps="true"
        android:textColor="@color/ds_text_secondary"
        android:textSize="11sp"
        tools:text="CN" />

    <TextView
        android:id="@+id/tvDateNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/open_sans_bold"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="@color/ds_text_primary"
        android:textSize="16.5sp"
        app:fontFamily="@font/open_sans_bold"
        tools:text="22" />

    <TextView
        android:id="@+id/tvDateSlotCount"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
