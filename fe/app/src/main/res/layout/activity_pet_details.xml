<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPetDetailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_home_bg">

    <!-- 1. Top App Bar: FrameLayout tôn trọng paddingTop từ WindowInsets để không bị cắt dưới thanh trạng thái -->
    <FrameLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_home_icon_btn_white"
            android:contentDescription="Quay lại"
            android:elevation="0dp"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/ds_text_primary" />

        <TextView
            style="@style/TextAppearance.PetCare.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/open_sans_bold"
            android:text="Hồ sơ thú cưng"
            android:textColor="@color/ds_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:fontFamily="@font/open_sans_bold" />

        <FrameLayout
            android:id="@+id/btnEditPetTop"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_home_icon_btn_white"
            android:clickable="true"
            android:contentDescription="Chỉnh sửa hồ sơ thú cưng"
            android:focusable="true">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_pencil"
                app:tint="@color/ds_text_primary" />
        </FrameLayout>
    </FrameLayout>

    <!-- Nội dung cuộn 3 phần -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPetDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomCta"
        android:layout_below="@id/layoutTopBar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutDetailsBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- HERO AVATAR: Bo vuông mềm 14dp trên nền kem #F3EDE4 + Tên Bold #1F1A17 + Mô tả phẳng -->
            <LinearLayout
                android:id="@+id/sectionHeroAvatar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPetHeroAvatar"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@color/ds_cream_tile"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_corgi_running"
                    app:shapeAppearanceOverlay="@style/RoundedCorner18"
                    app:strokeColor="@color/ds_border"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/tvPetHeroName"
                    style="@style/TextAppearance.PetCare.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:gravity="center"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/open_sans_bold"
                    tools:text="Miu Miu" />

                <TextView
                    android:id="@+id/tvPetHeroSpecies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:includeFontPadding="false"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13.5sp"
                    tools:text="Mèo Anh lông ngắn · 2 tuổi · Cái" />
            </LinearLayout>

            <!-- CARD 1: Thông tin cơ bản (Trắng #FFFFFF, viền 1dp #E6DFD5, bo 14dp, 0 shadow) -->
            <LinearLayout
                android:id="@+id/cardBasicInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_home_card_static"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.PetCare.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_bold"
                    android:text="Thông tin cơ bản"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/open_sans_bold" />

                <!-- Hàng 1: Tên thú cưng -->
                <LinearLayout
                    android:id="@+id/rowBasicName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_regular"
                        android:text="Tên thú cưng"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBasicNameValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/open_sans_semibold"
                        android:gravity="end"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        tools:text="Miu Miu" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ds_divider_hairline" />

                <!-- Hàng 2: Loài -->
                <LinearLayout
                    android:id="@+id/rowBasicSpecies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_regular"
                        android:text="Loài"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBasicSpeciesValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/open_sans_semibold"
                        android:gravity="end"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        tools:text="Mèo" />
                </LinearLayout>

                <!-- Hàng 3: Giống -->
                <View
                    android:id="@+id/dividerBasicBreedNote"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ds_divider_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rowBasicBreedNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_regular"
                        android:text="Giống"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBasicBreedNoteValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/open_sans_semibold"
                        android:gravity="end"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/open_sans_semibold"
                        tools:text="Anh lông ngắn" />
                </LinearLayout>

                <!-- Hàng 4: Giới tính -->
                <View
                    android:id="@+id/dividerBasicGender"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ds_divider_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rowBasicGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_regular"
                        android:text="Giới tính"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBasicGenderValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/open_sans_semibold"
                        android:gravity="end"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>

                <!-- Hàng 5: Tuổi -->
                <View
                    android:id="@+id/dividerBasicAge"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ds_divider_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rowBasicAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_regular"
                        android:text="Tuổi"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBasicAgeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/open_sans_semibold"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>

                <!-- Hàng 6: Cân nặng -->
                <View
                    android:id="@+id/dividerBasicWeight"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ds_divider_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rowBasicWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_regular"
                        android:text="Cân nặng"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBasicWeightValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/open_sans_semibold"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </LinearLayout>

                <!-- Hàng 7: Ghi chú -->
                <View
                    android:id="@+id/dividerBasicNotes"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ds_divider_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rowBasicNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_regular"
                        android:text="Ghi chú sức khỏe"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/tvBasicNotesValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/open_sans_regular"
                        android:lineSpacingMultiplier="1.25"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 2: Lịch sử khám & Sổ sức khỏe (Trắng #FFFFFF, viền 1dp #E6DFD5, bo 14dp) -->
            <LinearLayout
                android:id="@+id/cardHealthHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_home_card_static"
                android:elevation="0dp"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/TextAppearance.PetCare.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/btnSeeAllHistory"
                        android:fontFamily="@font/open_sans_bold"
                        android:text="Lịch sử khám"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:fontFamily="@font/open_sans_bold" />

                    <TextView
                        android:id="@+id/btnSeeAllHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/open_sans_semibold"
                        android:minHeight="36dp"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:text="Xem tất cả ›"
                        android:textColor="@color/ds_primary"
                        android:textSize="13sp"
                        app:fontFamily="@font/open_sans_semibold" />
                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/pbHistoryLoading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:indeterminateTint="@color/ds_primary"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/containerPetHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvHistoryEmpty"
                    style="@style/TextAppearance.PetCare.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:text="Chưa có lịch sử khám nào cho bé."
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom CTA cố định dưới đáy: viền trên 1dp #EAE3D9, nút bo 12dp #C85428 -->
    <LinearLayout
        android:id="@+id/layoutBottomCta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav_bar"
        android:elevation="0dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/btnBookForPet"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:elevation="0dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stethoscope"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvBookForPetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Đặt lịch khám cho bé"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
