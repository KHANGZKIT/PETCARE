<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:orientation="vertical">

    <!-- 1. Cố định Top Bar (nằm ngoài NestedScrollView, không bao giờ đè Status Bar) -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_outline"
                android:contentDescription="Quay lại"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/ds_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PetCare.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_bold"
                    android:letterSpacing="-0.015"
                    android:text="Chọn ngày &amp; giờ khám"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/open_sans_medium"
                    android:text="Bước 2/4"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ds_divider_hairline" />
    </LinearLayout>

    <!-- Nội dung cuộn chính -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- 2. Điều hướng Tháng / Năm (Month Navigator) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <ImageButton
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_btn_outline"
                    android:contentDescription="Tháng trước"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_left"
                    android:tint="@color/ds_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMonthYear"
                        style="@style/TextAppearance.PetCare.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_bold"
                        android:fontFeatureSettings="tnum"
                        android:text="Tháng 11, 2026"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="15.5sp"
                        app:fontFamily="@font/open_sans_bold" />

                    <TextView
                        android:id="@+id/tvSelectedDateSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:fontFeatureSettings="tnum"
                        android:text="CN · 22/11 đã chọn"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnNextMonth"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_btn_outline"
                    android:contentDescription="Tháng sau"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/ds_text_primary" />
            </LinearLayout>

            <!-- 3. Dải chọn ngày cuộn ngang (Gọn chỉ Thứ + Ngày) -->
            <HorizontalScrollView
                android:id="@+id/scrollDatesStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/containerDates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 4. Chú giải trạng thái khung giờ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:background="@drawable/bg_legend_box_available" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:text="Còn chỗ"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:background="@drawable/bg_legend_box_selected" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:text="Đang chọn"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:background="@drawable/bg_legend_box_unavailable" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:text="Đã đặt"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5A. TRẠNG THÁI CÓ KHUNG GIỜ: Chia 3 nhóm Sáng / Chiều / Tối -->
            <LinearLayout
                android:id="@+id/layoutSlotsAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Tổng quan chỗ trống -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/tvMorningHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:fontFamily="@font/open_sans_bold"
                        android:fontFeatureSettings="tnum"
                        android:text="Khung giờ khám · 0 chỗ trống"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="14sp"
                        app:fontFamily="@font/open_sans_bold" />
                </RelativeLayout>

                <!-- Nhóm 1: Sáng (08:30 – 11:30) -->
                <LinearLayout
                    android:id="@+id/sectionMorning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_semibold"
                        android:fontFeatureSettings="tnum"
                        android:text="Sáng (08:30 – 11:30)"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="12.5sp"
                        app:fontFamily="@font/open_sans_semibold" />

                    <LinearLayout
                        android:id="@+id/layoutSlotsMorning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Nhóm 2: Chiều (13:30 – 17:30) -->
                <LinearLayout
                    android:id="@+id/sectionAfternoon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_semibold"
                        android:fontFeatureSettings="tnum"
                        android:text="Chiều (13:30 – 17:30)"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="12.5sp"
                        app:fontFamily="@font/open_sans_semibold" />

                    <LinearLayout
                        android:id="@+id/layoutSlotsAfternoon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Nhóm 3: Tối (18:00 – 20:00) -->
                <LinearLayout
                    android:id="@+id/sectionEvening"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_semibold"
                        android:fontFeatureSettings="tnum"
                        android:text="Tối (18:00 – 20:00)"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="12.5sp"
                        app:fontFamily="@font/open_sans_semibold" />

                    <LinearLayout
                        android:id="@+id/layoutSlotsEvening"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5B. TRẠNG THÁI HẾT KHUNG GIỜ (No Slots Empty State) -->
            <LinearLayout
                android:id="@+id/layoutNoSlotsState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_empty_circle">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/ds_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvNoSlotsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:gravity="center"
                    android:text="Hết giờ khám trong ngày này"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="16sp"
                    app:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:id="@+id/tvNoSlotsBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Các khung giờ trong ngày này đã được đặt hết hoặc đã qua giờ hiện tại. Hãy chọn ngày khác phù hợp."
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />

                <android.widget.Button
                    android:id="@+id/btnJumpAvailableDate"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="@font/open_sans_semibold"
                    android:includeFontPadding="false"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:stateListAnimator="@null"
                    android:text="Xem ngày tiếp theo"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/btnNotifyWhenAvailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/open_sans_medium"
                    android:padding="8dp"
                    android:text="Nhận thông báo khi có chỗ"
                    android:textColor="@color/ds_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 6. Sticky Bottom Bar cố định phía dưới (1dp viền trên sắc nét, 0 bóng đổ) -->
    <LinearLayout
        android:id="@+id/layoutStickyBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav_bar"
        android:elevation="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Ghi chú nhỏ gọn thay cho hộp hồng GMT+7 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/open_sans_regular"
            android:gravity="center"
            android:text="Khung giờ được giữ cho đến khi phòng khám xác nhận."
            android:textColor="@color/ds_text_secondary"
            android:textSize="12sp" />

        <!-- Dòng tóm tắt ngày & giờ đã chọn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_medium"
                android:text="Lựa chọn của bạn"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvSelectedDateTimeSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/open_sans_semibold"
                android:fontFeatureSettings="tnum"
                android:gravity="end"
                android:text="Chưa chọn khung giờ"
                android:textColor="@color/ds_text_primary"
                android:textSize="13.5sp"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>

        <!-- Nút Tiếp tục chính 50dp bo 12dp -->
        <android.widget.Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="@font/open_sans_semibold"
            android:includeFontPadding="false"
            android:stateListAnimator="@null"
            android:text="Tiếp tục"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
