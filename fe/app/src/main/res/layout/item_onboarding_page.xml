<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="100">

    <!-- Warm Tactile 16dp Soft Peach Card with 1dp Border & Zero Elevation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="55"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOnboardingIllustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/ds_soft_peach"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/ds_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivOnboardingIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:padding="24dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/mascot_corgi_wave" />

        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="45"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/tvOnboardingTitle"
            style="@style/TextAppearance.PetCare.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_bold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/ds_text_primary"
            android:textSize="22sp"
            app:fontFamily="@font/open_sans_bold"
            tools:text="Chăm sóc bé cưng nhẹ nhàng hơn mỗi ngày" />

        <TextView
            android:id="@+id/tvOnboardingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/open_sans_regular"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/ds_text_secondary"
            android:textSize="14.5sp"
            tools:text="Lưu giữ hồ sơ sức khỏe và theo dõi lịch trình của từng bé tại một nơi duy nhất." />

    </LinearLayout>

</LinearLayout>
