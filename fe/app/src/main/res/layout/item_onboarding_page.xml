<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="100">

    <!-- Nửa trên (55%): CardView Soft Peach #FCE9E2, bo góc 32dp, không đổ bóng, không viền -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="55"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOnboardingIllustration"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardBackgroundColor="@color/ds_soft_peach"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivOnboardingIllustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:padding="28dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/mascot_petcare_intro" />

        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Nửa dưới (45%): Tiêu đề chính (24sp Bold #292524) & Mô tả phụ (15sp Regular #6F6662) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="45"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/tvOnboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_bold"
            android:gravity="center"
            android:letterSpacing="-0.015"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/ds_text_primary"
            android:textSize="24sp"
            tools:text="Chăm sóc bé cưng nhẹ nhàng hơn mỗi ngày" />

        <TextView
            android:id="@+id/tvOnboardingDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/open_sans_regular"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/ds_text_secondary"
            android:textSize="15sp"
            tools:text="Lưu giữ hồ sơ sức khỏe và theo dõi lịch trình của từng bé tại một nơi duy nhất." />

    </LinearLayout>

</LinearLayout>
