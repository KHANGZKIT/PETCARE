<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background">

    <!-- Nội dung chính -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. Thanh tiêu đề (App Bar) cố định -->
        <LinearLayout
            android:id="@+id/layoutTopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_outline"
                android:contentDescription="Quay lại"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/ds_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.PetCare.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_bold"
                    android:letterSpacing="-0.015"
                    android:text="Chọn dịch vụ"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Bước 1/4"
                    android:textColor="@color/ds_text_secondary"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Thẻ ngữ cảnh phòng khám đã chọn (Clinic Context Card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/cardSelectedClinic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_clinic_context_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Ảnh thumbnail phòng khám bo tròn 12dp -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivClinicThumb"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_clinic_cover"
                    app:shapeAppearanceOverlay="@style/RoundedCorner12" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvClinicName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Phòng khám Thú y An Nhiên"
                        android:textColor="@color/text_foreground"
                        android:fontFamily="@font/open_sans_semibold"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_map_pin"
                            android:tint="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvClinicArea"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Cầu Giấy · Hà Nội"
                            android:textColor="@color/text_muted"
                            android:fontFamily="@font/open_sans_regular"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Nút "Đổi" phòng khám -->
                <TextView
                    android:id="@+id/tvChangeClinic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="4dp"
                    android:paddingBottom="6dp"
                    android:text="Đổi"
                    android:textColor="@color/brand_primary"
                    android:fontFamily="@font/open_sans_medium"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Danh sách dịch vụ có thể cuộn -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewServices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="100dp">

                <!-- Số lượng dịch vụ nhận đặt lịch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_clock"
                        android:tint="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvServiceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="6 dịch vụ đang nhận đặt lịch"
                        android:textColor="@color/text_muted"
                        android:fontFamily="@font/open_sans_medium"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Container danh sách dịch vụ phẳng nguyên khối có viền 1dp #E6DFD5 -->
                <LinearLayout
                    android:id="@+id/containerServicesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_card_static"
                    android:clipToOutline="true"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- 4. Sticky Bottom Bar cố định phía dưới (1dp viền trên sắc nét, 0 bóng đổ) -->
    <LinearLayout
        android:id="@+id/layoutStickyBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav_bar"
        android:elevation="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Dòng tóm tắt dịch vụ đã chọn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã chọn"
                android:textColor="@color/text_muted"
                android:fontFamily="@font/open_sans_medium"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvSelectedServiceSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Tiêm phòng · 250.000 ₫"
                android:textColor="@color/text_foreground"
                android:fontFamily="@font/open_sans_semibold"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Nút Tiếp tục chính 52dp -->
        <android.widget.Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_primary"
            android:stateListAnimator="@null"
            android:text="Tiếp tục"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:fontFamily="@font/open_sans_semibold"
            android:includeFontPadding="false"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
