<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:orientation="vertical">

    <!-- Nội dung cuộn gọn gàng phía trên Sticky Bottom Bar -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContentSuccess"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- 1. Mascot Corgi ăn mừng + Tiêu đề Bold -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="148dp"
                    android:layout_height="122dp"
                    android:contentDescription="Mascot đặt lịch thành công"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascot_corgi_success" />

                <TextView
                    style="@style/TextAppearance.PetCare.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/open_sans_bold"
                    android:letterSpacing="-0.02"
                    android:text="Đặt lịch thành công"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:fontFamily="@font/open_sans_bold" />

                <TextView
                    android:id="@+id/tvSuccessSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/open_sans_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:maxWidth="300dp"
                    android:text="Phòng khám đã nhận yêu cầu của bạn và sẽ xác nhận trong ít phút."
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="● Chờ phòng khám xác nhận"
                    android:textColor="@color/ds_warning"
                    android:textSize="12.5sp"
                    app:fontFamily="@font/open_sans_semibold" />
            </LinearLayout>

            <!-- 2. Phiếu tóm tắt lịch hẹn (Ticket Card viền mảnh 1dp #E6DFD5) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_clinic"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dịch vụ đã chọn -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_shortcut_icon_cream">

                        <ImageView
                            android:id="@+id/ivServiceIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_syringe"
                            android:tint="@color/ds_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvServiceName"
                            style="@style/TextAppearance.PetCare.CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans_bold"
                            android:text="Tiêm phòng"
                            android:textColor="@color/ds_text_primary"
                            android:textSize="15sp"
                            app:fontFamily="@font/open_sans_bold" />

                        <TextView
                            android:id="@+id/tvServiceDurationPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/open_sans_medium"
                            android:fontFeatureSettings="tnum"
                            android:text="20 phút · 250.000 ₫"
                            android:textColor="@color/ds_text_secondary"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Đường kẻ nét đứt kiểu Phiếu hẹn -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_divider_dashed"
                    android:layerType="software" />

                <!-- Phòng khám -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_map_pin"
                        android:tint="@color/ds_text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvClinicName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans_semibold"
                            android:text="Thú y PetCare Cầu Diễn"
                            android:textColor="@color/ds_text_primary"
                            android:textSize="13.5sp"
                            app:fontFamily="@font/open_sans_semibold" />

                        <TextView
                            android:id="@+id/tvClinicArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/open_sans_regular"
                            android:text="Cầu Giấy · Hà Nội"
                            android:textColor="@color/ds_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Ngày giờ khám -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar_days"
                        android:tint="@color/ds_text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDateTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans_semibold"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/ds_text_primary"
                            android:textSize="13.5sp"
                            app:fontFamily="@font/open_sans_semibold"
                            tools:text="CN, 22/11 · 10:00" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/open_sans_regular"
                            android:text="Vui lòng đến sớm 10 phút"
                            android:textColor="@color/ds_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Thú cưng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_paw"
                        android:tint="@color/ds_text_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPetNameBreed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans_semibold"
                            android:text="Mochi · Pomeranian"
                            android:textColor="@color/ds_text_primary"
                            android:textSize="13.5sp"
                            app:fontFamily="@font/open_sans_semibold" />

                        <TextView
                            android:id="@+id/tvPetAgeSex"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/open_sans_regular"
                            android:text="2 tuổi · Cái"
                            android:textColor="@color/ds_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. Sticky Bottom Bar cố định: luôn hiển thị 2 nút hành động -->
    <LinearLayout
        android:id="@+id/layoutStickyBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav_bar"
        android:elevation="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Nút chính: Xem lịch hẹn (#C85428, bo 12dp) -->
        <LinearLayout
            android:id="@+id/btnViewAppointmentDetails"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_days"
                android:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/open_sans_semibold"
                android:text="Xem lịch hẹn"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>

        <!-- Nút phụ: Về trang chủ (viền 1dp #C85428, chữ #C85428, bo 12dp) -->
        <LinearLayout
            android:id="@+id/btnBackToHome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_outline_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home"
                android:tint="@color/ds_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/open_sans_semibold"
                android:text="Về trang chủ"
                android:textColor="@color/ds_primary"
                android:textSize="14.5sp"
                app:fontFamily="@font/open_sans_semibold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
