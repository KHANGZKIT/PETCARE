<?xml version="1.0" encoding="utf-8"?>
<!-- Crisp 1dp top border #EAE3D9 on pure white bottom nav bar (0 shadow) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_nav_border" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface" />
        </shape>
    </item>
</layer-list>
