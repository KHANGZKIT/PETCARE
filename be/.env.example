# ============================================================
# PET CARE Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your local values.
# Spring Boot does NOT read .env files by default.
# Set these as system/user environment variables, or pass them
# via IDE run configuration, or use a shell script.
# ============================================================

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/pet_care
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Server port (default: 8080)
SERVER_PORT=8080
